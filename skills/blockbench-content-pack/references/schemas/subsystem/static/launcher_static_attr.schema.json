{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://machine_max.io/schemas/subsystem/static/launcher_static_attr.json",
  "title": "发射器子系统静态属性",
  "description": "发射器子系统的静态属性，包含炮管、炮闩、电容三个模块的配置。",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema 引用路径，用于编辑器的智能提示和校验",
      "default": "../../docs/zh_cn/schemas/subsystem/subsystem_static_attr.schema.json"
    },
    "type": {
      "type": "string",
      "const": "machine_max:launcher",
      "description": "子系统类型，必须为 'machine_max:launcher'。"
    },
    "basic_durability": {
      "type": "number",
      "minimum": 0,
      "default": 20.0,
      "description": "子系统基础耐久度。降为 0 时瘫痪，修复至 30% 时恢复功能。"
    },
    "pass_damage": {
      "type": "boolean",
      "default": true,
      "description": "是否将伤害传递给子系统持有者。为 true 时子系统受到的伤害会传递给零件。"
    },
    "limit_damage": {
      "type": "boolean",
      "default": false,
      "description": "是否限制伤害传递值不超过子系统剩余耐久度。例如 40 伤害、剩余 20，则只传递 20。"
    },
    "hidden": {
      "type": "boolean",
      "default": false,
      "description": "是否在 HUD 中隐藏该子系统，常用于仅提供模型零件伤害区分的非功能子系统。"
    },
    "control_inputs": {
      "type": "array",
      "items": { "type": "string" },
      "default": ["weapon_control"],
      "description": "开火信号输入频道列表，优先级从高到低。"
    },
    "single_round_loading": {
      "type": "boolean",
      "default": false,
      "description": "一次拉取装多少发：true 只把一发推进膛室，不建立已装数据；false 把整份 Belt 装进已装数据。按武器实际怎么装填填写，与口径、射速和供给者类型无关：一次只把一发推进膛室的武器（主炮、导弹发射管、逐发取弹的机关炮）填 true，由弹链或弹匣整份供弹的机枪、机关炮填 false。"
    },
    "human_reload_time": {
      "type": "number",
      "minimum": 0,
      "default": 0,
      "description": "完整人力装填流程的基准秒数（标准人力）：本型号直接从弹药架取弹、由乘员全程装填，机械段为零。省略或写 0 表示不支持该路径，这根管只经自动装弹机装填；负值与非有限值是解码错误。交付方自己声明了人工段时由它负责用人，本字段不参与。实际时长还要乘岗位倍率与该乘员的个人倍率。配了人工段却没有座位声明本管的装填人员频道时，这条流程等不到执行者，启动时会告警。"
    },
    "sounds": {
      "type": "object",
      "properties": {
        "on_deactivate": {
          "allOf": [
            { "$ref": "../../base/sound_event.schema.json" }
          ],
          "description": "子系统失活时的音效。",
          "default": {
            "sound_id": "machine_max:empty_sound",
            "range": 16
          }
        },
        "on_destroyed": {
          "allOf": [
            { "$ref": "../../base/sound_event.schema.json" }
          ],
          "description": "子系统被摧毁时的音效。",
          "default": {
            "sound_id": "machine_max:empty_sound",
            "range": 16
          }
        },
        "on_activate": {
          "allOf": [
            { "$ref": "../../base/sound_event.schema.json" }
          ],
          "description": "子系统激活时的音效。",
          "default": {
            "sound_id": "machine_max:empty_sound",
            "range": 16
          }
        },
        "dry_fire": {
          "allOf": [
            { "$ref": "../../base/sound_event.schema.json" }
          ],
          "description": "空膛击发音效（扣扳机但无弹药时播放）。",
          "default": {
            "sound_id": "machine_max:subsystem.launcher.dry_fire",
            "range": 16
          }
        },
        "human_progress_sounds": {
          "type": "object",
          "description": "人工段的进度分段音效：键是 '0.0'~'1.0' 的十进制字符串，值是该进度阈值上播放的音效。阈值 0 是段开始音、1 是段走完的音，两者不进越过循环；一次推进跨过多个阈值时按阈值升序逐个播放。声音定位在本管上——人力直取路径没有机构。只有交付方自己声明了人工段时由它播，本表用于本型号自己负责的人工段。",
          "additionalProperties": { "allOf": [{ "$ref": "../../base/sound_event.schema.json" }] }
        },
        "fmod": {
          "type": "object",
          "description": "开火事件。机枪单发、连射和尾音由 firing 参数控制，播放接线待实现。",
          "properties": {
            "bank": {
              "description": "FMOD bank ID",
              "type": "string"
            },
            "fire": {
              "type": "string",
              "pattern": "^event:/.+",
              "description": "fire"
            }
          },
          "required": [
            "bank",
            "fire"
          ],
          "additionalProperties": false
        },
        "decay_power": {
          "type": "number",
          "minimum": 0,
          "default": 2.0,
          "description": "炮管衰减曲线指数。值越大，战损初期性能下降越平缓、后期下降越陡峭。"
        },
        "damaged_spread": {
          "type": "number",
          "minimum": 0,
          "default": 2.0,
          "description": "战损极限散布乘数。耐久→0 但未归零时的精度损失倍率。"
        },
        "destroyed_spread": {
          "type": "number",
          "minimum": 0,
          "default": 8.0,
          "description": "摧毁散布乘数。耐久归零后的精度损失倍率（质变悬崖）。"
        },
        "damaged_muzzle_velocity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1.0,
          "default": 0.7,
          "description": "战损极限初速乘数。耐久→0 但未归零时的初速比例。"
        },
        "destroyed_muzzle_velocity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1.0,
          "default": 0.1,
          "description": "摧毁初速乘数。耐久归零后的初速比例。"
        },
        "velocity_multiplier": {
          "type": "number",
          "minimum": 0,
          "default": 1.0,
          "description": "初速乘数，先应用此（炮管长度/膛线决定）。"
        },
        "velocity_bonus": {
          "type": "number",
          "default": 0,
          "description": "初速线性加成 (m/s)。"
        },
        "horizontal_accuracy_multiplier": {
          "type": "number",
          "minimum": 0,
          "default": 1.0,
          "description": "水平精度乘子。1.0 = 不改变弹丸默认水平精度。"
        },
        "vertical_accuracy_multiplier": {
          "type": "number",
          "minimum": 0,
          "default": 1.0,
          "description": "垂直精度乘子。1.0 = 不改变弹丸默认垂直精度。"
        },
        "recoil_multiplier": {
          "type": "number",
          "minimum": 0,
          "default": 1.5,
          "description": "后坐力倍率。总后坐冲量 = 弹丸总动量 × 此值。1.0 = 仅弹丸动量；默认 1.5 ≈ 弹丸+火药燃气（炮口暴风）；炮口制退器 < 1.0；无后坐力设计 ≈ 0。"
        }
      },
      "additionalProperties": false,
      "description": "炮管模块属性——定义精度、初速、后坐力的基准值及战损/摧毁衰减。"
    },
    "breech": {
      "type": "object",
      "properties": {
        "durability_weight": {
          "type": "number",
          "minimum": 0,
          "default": 1.0,
          "description": "模块耐久权重。子系统总耐久按各模块权重比例分配。"
        },
        "fire_rate": {
          "type": "number",
          "minimum": 0,
          "description": "射速 (RPM)。"
        },
        "required_tags": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "弹药必须全部具备的 tag。空列表表示不要求。"
        },
        "acceptable_tags": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "弹药至少具备其一即可的 tag。空列表表示接受任意。"
        },
        "forbidden_tags": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "弹药不能包含的 tag。空列表表示不禁止。"
        }
      },
      "additionalProperties": false,
      "description": "炮闩模块属性——定义射速和弹药兼容性约束。"
    },
    "capacitor": {
      "type": "object",
      "properties": {
        "durability_weight": {
          "type": "number",
          "minimum": 0,
          "default": 1.0,
          "description": "模块耐久权重。子系统总耐久按各模块权重比例分配。"
        },
        "decay_power": {
          "type": "number",
          "minimum": 0,
          "default": 2.0,
          "description": "电容衰减曲线指数。"
        },
        "damaged_charge_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1.0,
          "default": 0.5,
          "description": "战损极限蓄力速率乘数。"
        },
        "destroyed_charge_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1.0,
          "default": 0.0,
          "description": "摧毁蓄力速率乘数。"
        },
        "damaged_max_power": {
          "type": "number",
          "minimum": 0,
          "maximum": 1.0,
          "default": 0.7,
          "description": "战损极限最大功率乘数。"
        },
        "destroyed_max_power": {
          "type": "number",
          "minimum": 0,
          "maximum": 1.0,
          "default": 0.0,
          "description": "摧毁最大功率乘数。"
        }
      },
      "additionalProperties": false,
      "description": "电容模块属性（可选，用于磁轨炮等蓄力武器）。"
    }
  },
  "required": ["type"],
  "additionalProperties": false,
  "examples": [
    {
      "type": "machine_max:launcher",
      "description": "最简示例——仅必需字段，使用所有默认值"
    },
    {
      "type": "machine_max:launcher",
      "basic_durability": 80,
      "control_inputs": ["weapon.autocannon"],
      "description": "标准示例——基础发射器配置（类型级火控频道）"
    },
    {
      "type": "machine_max:launcher",
      "single_round_loading": true,
      "human_reload_time": 5,
      "sounds": {
        "human_progress_sounds": {
          "0.0": { "sound_id": "machine_max:subsystem.loader.reload_start", "range": 16 },
          "0.5": { "sound_id": "machine_max:subsystem.loader.reload_shell", "range": 16 },
          "0.9": { "sound_id": "machine_max:subsystem.loader.reload_close", "range": 16 }
        }
      },
      "description": "人力直取示例——炮塔上没有装弹机，由乘员从弹药架取弹并全程装填"
    }
  ]
}
