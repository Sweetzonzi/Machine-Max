{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://machine_max.io/schemas/subsystem/dynamic/coupler_dynamic_attr.json",
  "title": "锁扣动态属性",
  "description": "绑定本子零件上的一个高级连接点作为主动端。被动端不配置：运行时在同一载具内按距离与双向安装条件发现最近的兼容简单端。",
  "properties": {
    "type": {
      "type": "string",
      "const": "machine_max:coupler",
      "description": "子系统类型。"
    },
    "definition": {
      "type": "string",
      "description": "锁扣型号的资源地址。"
    },
    "connector": {
      "type": "string",
      "description": "主动高级连接点名称；一个高级连接点最多挂一个锁扣。"
    },
    "state_outputs": {
      "allOf": [
        { "$ref": "../base/signal_targets.json" }
      ],
      "default": {},
      "description": "扣合状态的输出频道及目标。每个频道每 tick 发一个数字：1 为扣合，0 为未扣合（未装件、已解扣或锁扣被打脱）。频道名由作者取、作用域是整个装配体的信号存储，因此同一装配体上并列的两把锁扣要取两个不同的名字；跨零件的门控条件按这个名字读 global.get。"
    }
  },
  "required": ["type", "definition", "connector"],
  "additionalProperties": false,
  "examples": [
    {
      "type": "machine_max:coupler",
      "definition": "machine_max:door_latch",
      "connector": "connector.machine_max.left_front_door_lock"
    },
    {
      "type": "machine_max:coupler",
      "definition": "machine_max:door_latch",
      "connector": "connector.machine_max.left_door_lock",
      "state_outputs": {
        "senna_left_door_latched": ["global"]
      }
    }
  ]
}
