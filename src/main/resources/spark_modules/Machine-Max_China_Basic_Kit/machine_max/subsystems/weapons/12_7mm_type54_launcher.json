{
  "type": "machine_max:launcher",
  "single_round_loading": false,
  "basic_durability": 20,
  "pass_damage": false, //(可选, 默认true)是否将子系统受到的伤害传递给零件
  "control_inputs": [
    "weapon.mg",
    "weapon.mg.type54"
  ],
  "barrel": {
    "horizontal_accuracy_multiplier": 2,
    "vertical_accuracy_multiplier": 2
  },
  "breech": {
    "fire_rate": 600,
    "required_tags": [
      "machine_max:caliber/12_7mm"
    ]
  },
  //开火这一层的声音都按本型号配置：0.0 是单发，其余键是连射循环档位（按 fire_rate 取最近的一档）
  "sounds": {
    "fire": {
      "0.0": {
        "sound_id": "machine_max:projectile.fire.small",
        "range": 128.0
      }
    },
    "shell": {
      "0.0": {
        "sound_id": "machine_max:projectile.shell.fall",
        "range": 16.0
      },
      "600.0": {
        "sound_id": "machine_max:projectile.shell.shells_fall",
        "range": 16.0
      }
    },
    "fmod": {
      "bank": "machine_max:basic_vehicle_sounds",
      "fire": "event:/Default_Vehicles/Armament/Guns/Loop/m2hb"
    }
  },
  "$schema": "../../docs/zh_cn/schemas/subsystem/subsystem_static_attr.schema.json"
}
