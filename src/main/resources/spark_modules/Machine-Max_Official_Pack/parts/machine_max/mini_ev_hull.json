  "sub_parts": {//零件(子部件)列表
    "mini_ev_hull": {//零件(子部件)名称
      "mass": 620.0,//零件质量(kg)
      "block_collision": "ground",//(可选)地形碰撞模式:true(默认，与所有方块碰撞),ground(仅与部件之下的地面方块碰撞),false(不与任何方块碰撞)
      "collision_height": 1.5,//(可选)碰撞检测高度(m)，遭遇的障碍小于此高度时不与障碍发生碰撞(方块碰撞模式需要为ground)，默认所有障碍均碰撞
      "mass_center": "MassCenter",//(可选)质心Locator名称，会寻找名称匹配的Locator，以其位置作为质心，留空则取坐标原点
      "hit_boxes": {//键:骨骼名称，会寻找名称匹配的骨骼，并根据其中的方块创建不同形状的碰撞体，以及将此骨骼下的定位器储存起来供子系统等使用
        "HullCollisionShape": {//值:碰撞形状属性
          "name": "part",//(可选，默认"part")碰撞箱名称，供子系统等查找
          "type": "box",//碰撞形状类型，支持box、sphere、cylinder
          "block_damage_factor": 1.0,//(可选，默认1.0)方块损伤系数，0为无法破坏方块，1为造成全额伤害，调整此系数以改变对方块的破坏能力
          "angle_effect": true,//(可选，默认true)等效护甲厚度是否受入射角度影响，若为false，则计算厚度时不考虑入射角度
          "un_penetrate_damage_factor": 0.5,//(可选，默认0.0)攻击未能完全击穿护甲时的伤害系数，公式为:攻击伤害*(穿深/等效护甲)^un_penetrate_damage_factor，此项为0.0时未击穿则无伤害
          "rha": 1 //(可选，默认1)等效护甲厚度，单位mm，减免伤害并控制碰撞时的能量分配情况
        },
        "EngineCollisionShape": {//值:碰撞形状属性
          "name": "engine",//(可选，默认"part")碰撞箱名称，供子系统等查找
          "type": "box",//碰撞形状类型，支持box、sphere、cylinder
          "block_damage_factor": 2.0,//(可选，默认1.0)方块损伤系数，0为无法破坏方块，1为造成全额伤害，调整此系数以改变对方块的破坏能力
          "angle_effect": true,//(可选，默认true)等效护甲厚度是否受入射角度影响，若为false，则计算厚度时不考虑入射角度
          "un_penetrate_damage_factor": 0.5,//(可选，默认0.0)攻击未能完全击穿护甲时的伤害系数，公式为:攻击伤害*(穿深/等效护甲)^un_penetrate_damage_factor，此项为0.0时未击穿则无伤害
          "rha": 3 //(可选，默认1)等效护甲厚度，单位mm，减免伤害并控制碰撞时的能量分配情况
        }
      },
      "interact_boxes": {//交互判定区列表
        "interact.machine_max.mini_ev.left_front_door": {//键:交互判定区名称
