{
  "name": "mini_ev_wheel",//部件名称，必须与文件名相同，必须与文件名相同，必须与文件名相同
  "vehicle_durability_rate": 0.8,//(可选，默认1.0)载具耐久贡献系数，部件耐久度按此比例贡献给载具总耐久度
  "vehicle_damage_rate": 1.0,//(可选，默认1.0)常态载具伤害传导系数，部件受到伤害时按此比例传导给载具
  "vehicle_damage_rate_destroyed": 0.1,//(可选，默认0.5)部件被摧毁后的载具伤害传导系数，部件被摧毁后受到伤害时按此比例传导给载具
  "basic_durability": 20.0,//(可选，默认20.0)部件基础生命值，降至0时部件的所有子系统会瘫痪
  "basic_integrity": 15.0,//(可选，默认15.0)部件基础结构完整度，部件可承受不高于此数值的伤害(计算甲弹对抗前)而不脱落，受到伤害(计算甲弹对抗前)或连接处承受过大负载时会降低完整度
  "variants": {//部件变体列表，支持单值或多键值对
    "left": {//变体名称
      "icon": "machine_max:textures/icon/mini_ev_wheel_icon.png",//(可选，留空会使用第一张模型贴图)部件图标路径
      "models": "machine_max:mini_ev_wheel_left.geo", //模型路径
      "textures": [ //贴图路径列表
        "machine_max:textures/part/mini_ev_ae86.png"
      ],
      "animations": "machine_max:empty", //(可选，留空则不播放动画)动画路径
      "tags": ["wheel", "mini", "left"],//(可选)部件标签列表
      "sub_parts": {//零件(子部件)列表
        "mini_ev_wheel": {//零件(子部件)名称
          "mass": 25.0,//零件质量(kg)
          "block_collision": "ground",//(可选，默认true)地形碰撞模式:true(与所有方块碰撞),ground(仅与低于部件最低位置的地面方块碰撞),false(不与任何方块碰撞)
          "collision_height": 1.5,//(可选)碰撞检测高度(m)，遭遇的障碍小于此高度时不与障碍发生碰撞(方块碰撞模式需要为ground)，默认所有障碍均碰撞
          "climb_assist": true,//(可选，默认false)是否开启自动攀爬辅助，开启后会在自动攀爬时提供额外的速度
          "hit_boxes": {//键:骨骼名称，会寻找名称匹配的骨骼，并根据其中的方块创建不同形状的碰撞体，以及将此骨骼下的定位器储存起来供子系统等使用
            "CollisionShape": {//骨骼名称，会寻找名称匹配的骨骼，并根据其中的方块创建不同形状的碰撞体
              "type": "cylinder",//碰撞形状类型，支持box、sphere、cylinder、wheel
              "friction": [1.5, 2.0, 1.0],//(可选，默认[0.5, 0.5, 0.5])各向异性摩擦系数[侧向, 前向, 疑似无用]
              "slip_adaptation": 0.5,//(可选，默认0.5)滑动适应性系数(0~1)，该属性可削弱打滑时的摩擦系数降低效果，提升抓地力
              "rolling_friction": 0.05,//(可选，默认0.2)滚动摩擦系数，影响滚动阻力
              "restitution": 0.2,//(可选，默认0.1)弹性系数，0为完全非弹性碰撞，1为完全弹性碰撞，碰撞时以此系数和相碰物体的弹性系数之积作为最终弹性系数
              "block_damage_factor": 0.05, //(可选，默认1.0)方块损伤系数，0为无法破坏方块，1为造成全额伤害，调整此系数以改变对方块的破坏能力
              "collision_damage_reduction": 3.0 //(可选，默认1.0)碰撞伤害减免，小于此数值的伤害会被免疫，大于此数值的伤害会被减免
            }
          },
          "connectors": {//子部件用于与其他零件连接的对接口列表
            "chassis_connection": {//接口名称
              "locator": "AttachPoint",//Locator名称，会寻找名称匹配的Locator，以其位置与姿态作为对接口的位置和姿态
              "type": "AttachPoint"//对接口类型，支持AttachPoint和Special
            }
          }
        }
      }
    },
    "right": {//变体名称
      "icon": "machine_max:textures/icon/mini_ev_wheel_icon.png",//(可选，留空会使用第一张模型贴图)部件图标路径
      "models": "machine_max:mini_ev_wheel_right.geo", //模型路径
      "textures": [ //贴图路径列表
        "machine_max:textures/part/mini_ev_ae86.png"
      ],
      "animations": "machine_max:empty", //(可选，留空则不播放动画)动画路径
      "tags": ["wheel", "mini", "right"],//(可选)部件标签列表
      "sub_parts": {//零件(子部件)列表
        "mini_ev_wheel": {//零件(子部件)名称
          "mass": 25.0,//零件质量(kg)
          "block_collision": "ground",//(可选，默认true)地形碰撞模式:true(与所有方块碰撞),ground(仅与低于部件最低位置的地面方块碰撞),false(不与任何方块碰撞)
          "collision_height": 1.5,//(可选)碰撞检测高度(m)，遭遇的障碍小于此高度时不与障碍发生碰撞(方块碰撞模式需要为ground)，默认所有障碍均碰撞
          "climb_assist": true,//(可选，默认false)是否开启自动攀爬辅助，开启后会在自动攀爬时提供额外的速度
          "hit_boxes": {//键:骨骼名称，会寻找名称匹配的骨骼，并根据其中的方块创建不同形状的碰撞体，以及将此骨骼下的定位器储存起来供子系统等使用
            "CollisionShape": {//骨骼名称，会寻找名称匹配的骨骼，并根据其中的方块创建不同形状的碰撞体
              "type": "cylinder",//碰撞形状类型，支持box、sphere、cylinder、wheel
              "friction": [1.7, 2.2, 1.0],//(可选，默认[0.5, 0.5, 0.5])各向异性摩擦系数[侧向, 前向, 疑似无用]
              "slip_adaptation": 0.5,//(可选，默认0.5)滑动适应性系数(0~1)，该属性可削弱打滑时的摩擦系数降低效果，提升抓地力
              "rolling_friction": 0.05,//(可选，默认0.2)滚动摩擦系数，影响滚动阻力
              "restitution": 0.2,//(可选，默认0.1)弹性系数，0为完全非弹性碰撞，1为完全弹性碰撞，碰撞时以此系数和相碰物体的弹性系数之积作为最终弹性系数
              "block_damage_factor": 0.05, //(可选，默认1.0)方块损伤系数，0为无法破坏方块，1为造成全额伤害，调整此系数以改变对方块的破坏能力
              "collision_damage_reduction": 3.0 //(可选，默认1.0)碰撞伤害减免，小于此数值的伤害会被免疫，大于此数值的伤害会被减免
            }
          },
          "connectors": {//子部件用于与其他零件连接的对接口列表
            "chassis_connection": {//接口名称
              "locator": "AttachPoint",//Locator名称，会寻找名称匹配的Locator，以其位置与姿态作为对接口的位置和姿态
              "type": "AttachPoint"//对接口类型，支持AttachPoint和Special
            }
          }
        }
      }
    }
  }
}