{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://machine_max.io/schemas/part/variant_attr.json",
  "title": "Part Variant Attributes",
  "description": "Defines a variant of a vehicle part, including the variant's appearance, models, sub-parts, etc. Supports multi-state mapping.",
  "type": "object",
  "properties": {
    "icon": {
      "$ref": "../base/resource_location.schema.json",
      "description": "Part icon path, used for UI display. If left empty, a purple-black default icon will be used as the icon"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "List of part tags, used for connection point matching and functional classification"
    },
    "model": {
      "$ref": "../base/resource_location.schema.json",
      "description": "Model path configuration, 无视内层文件夹架构，例如machine_max:ae86_chassis.geo会在所有内容包的models/machine_max/part的所有子目录中中寻找ae86_chassis.geo.json"
    },
    "textures": {
      "oneOf": [
        {
          "$ref": "../base/resource_location.schema.json",
          "default": "minecraft:missingno",
          "description": "单一纹理，例如\"machine_max:textures/part/ae86/ae86_armor.png\"会将内容包相应路径的图像作为部件的\"default\"纹理"
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "../base/resource_location.schema.json"
          },
          "default": {
            "default": "minecraft:missingno"
          },
          "description": "名称到纹理列表的映射，键为纹理名称，值为纹理路径。例如：\"textures\": {\n            \"example_2\": \"machine_max:textures/part/texture_2.png\"\n          }则会将相应路径的图像作为部件的\"example_2\"纹理。"
        }
      ],
      "default": {},
      "description": "纹理路径配置。"
    },
    "animations": {
      "$ref": "../base/resource_location.schema.json",
      "default": {},
      "description": "动画路径，无视内层文件夹架构，例如machine_max:ae86会在所有内容包的animations/machine_max/part/ae86中的所有动画json作为模型的可用动画"
    },
    "sub_parts": {
      "type": "object",
      "additionalProperties": {
        "$ref": "subpart/sub_part_attr.schema.json"
      },
      "minProperties": 1,
      "description": "Sub-part (component) definition, key is sub-part name, value is detailed configuration of the sub-part. This is the smallest unit of part movement, each movable part of the part should be a sub-part"
    }
  },
  "additionalProperties": false,
  "required": ["models", "sub_parts"],
  "examples": [
    {
      "icon": "machine_max:textures/icon/ae86_chassis_all_terrain_icon.png",
      "models": "machine_max:ae86_chassis_all_terrain.geo",
      "textures": [
        "machine_max:textures/part/ae86_all_terrain_1.png",
        "machine_max:textures/part/ae86_all_terrain_2.png"
      ],
      "animations": "machine_max:ae86",
      "tags": [],
      "sub_parts": {
        "ae86_chassis_all_terrain": {
          "durability": 550.0,
          "mass": 1200.0,
          "hit_boxes": {
            "mmCollision_Box_Chassis": {
              "name": "chassis",
              "type": "box",
              "rha": 10
            }
          }
        }
      }
    },
    {
      "icon": "machine_max:textures/icon/tank_turret_icon.png",
      "models": {
        "default": "machine_max:tank_turret_normal.geo",
        "broken": "machine_max:tank_turret_damaged.geo"
      },
      "textures": {
        "default": [
          "machine_max:textures/part/tank_turret_1.png",
          "machine_max:textures/part/tank_turret_2.png"
        ],
        "broken": [
          "machine_max:textures/part/tank_turret_damaged_1.png",
          "machine_max:textures/part/tank_turret_damaged_2.png"
        ]
      },
      "animations": {
        "default": "machine_max:tank_turret_rotation",
        "broken": "machine_max:tank_turret_broken"
      },
      "tags": ["turret", "rotatable"],
      "sub_parts": {
        "turret_base": {
          "durability": 300.0,
          "mass": 800.0,
          "hit_boxes": {
            "mmCollision_Turret": {
              "name": "turret",
              "type": "cylinder",
              "rha": 50
            }
          }
        }
      }
    }
  ]
}