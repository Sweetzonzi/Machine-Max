{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://machine_max.io/schemas/part/variant_attr.json",
  "title": "部件变体属性",
  "description": "定义载具部件的一个变体（Variant），包含该变体的外观、模型、子部件等配置。支持多状态（state）映射。",
  "type": "object",
  "properties": {
    "icon": {
      "$ref": "../base/resource_location.schema.json",
      "description": "部件图标路径，用于UI显示。若留空会使用紫黑缺省图标作为图标"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "部件标签列表，用于连接点匹配和功能分类"
    },
    "models": {
      "oneOf": [
        {
          "$ref": "../base/resource_location.schema.json",
          "description": "单一模型路径，使用默认状态（\"default\"）"
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "../base/resource_location.schema.json"
          },
          "minProperties": 1,
          "description": "状态到模型路径的映射，键为状态名（如\"default\"、\"broken\"、\"open\"等）"
        }
      ],
      "description": "模型路径配置，支持单一模型（默认状态）或多状态映射。必须至少有一个模型"
    },
    "textures": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "$ref": "../base/resource_location.schema.json"
          },
          "minItems": 0,
          "description": "单一纹理列表，使用默认状态（\"default\"）"
        },
        {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "../base/resource_location.schema.json"
            },
            "minItems": 0
          },
          "default": {},
          "description": "状态到纹理列表的映射，键为状态名，值为纹理路径数组"
        }
      ],
      "default": {},
      "description": "贴图路径配置，支持单一纹理列表或多状态映射"
    },
    "animations": {
      "oneOf": [
        {
          "$ref": "../base/resource_location.schema.json",
          "description": "单一动画路径，使用默认状态（\"default\"）"
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "../base/resource_location.schema.json"
          },
          "default": {},
          "description": "状态到动画路径的映射，键为状态名，值为动画路径"
        }
      ],
      "default": {},
      "description": "动画路径配置，支持单一动画或多状态映射。留空则不播放动画"
    },
    "sub_parts": {
      "type": "object",
      "additionalProperties": {
        "$ref": "subpart/sub_part_attr.schema.json"
      },
      "minProperties": 1,
      "description": "子部件（零件）定义，键为子部件名称，值是子部件的详细配置。这是部件运动的最小单元，部件的每个可动部分都应当是一个子部件"
    }
  },
  "additionalProperties": false,
  "required": ["models", "sub_parts"],
  "examples": [
    {
      "icon": "machine_max:textures/icon/ae86_chassis_all_terrain_icon.png",
      "models": "machine_max:ae86_chassis_all_terrain.geo",
      "textures": [
        "machine_max:textures/part/ae86_all_terrain_1.png",
        "machine_max:textures/part/ae86_all_terrain_2.png"
      ],
      "animations": "machine_max:ae86",
      "tags": [],
      "sub_parts": {
        "ae86_chassis_all_terrain": {
          "durability": 550.0,
          "mass": 1200.0,
          "hit_boxes": {
            "mmCollision_Box_Chassis": {
              "name": "chassis",
              "type": "box",
              "rha": 10
            }
          }
        }
      }
    },
    {
      "icon": "machine_max:textures/icon/tank_turret_icon.png",
      "models": {
        "default": "machine_max:tank_turret_normal.geo",
        "broken": "machine_max:tank_turret_damaged.geo"
      },
      "textures": {
        "default": [
          "machine_max:textures/part/tank_turret_1.png",
          "machine_max:textures/part/tank_turret_2.png"
        ],
        "broken": [
          "machine_max:textures/part/tank_turret_damaged_1.png",
          "machine_max:textures/part/tank_turret_damaged_2.png"
        ]
      },
      "animations": {
        "default": "machine_max:tank_turret_rotation",
        "broken": "machine_max:tank_turret_broken"
      },
      "tags": ["turret", "rotatable"],
      "sub_parts": {
        "turret_base": {
          "durability": 300.0,
          "mass": 800.0,
          "hit_boxes": {
            "mmCollision_Turret": {
              "name": "turret",
              "type": "cylinder",
              "rha": 50
            }
          }
        }
      }
    }
  ]
}