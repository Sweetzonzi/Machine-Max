{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://machine_max.io/schemas/subsystem/dynamic/item_storage_dynamic_attr.json",
  "title": "物品存储子系统动态属性",
  "description": "物品存储容器的动态属性，只需指定型号即可。",
  "allOf": [
    { "$ref": "../base/abstract_subsystem_attr.schema.json" }
  ],
  "properties": {
    "type": {
      "type": "string",
      "const": "machine_max:item_storage",
      "description": "子系统类型，必须为'machine_max:item_storage'。"
    }
  },
  "required": ["type", "model"],
  "additionalProperties": false,
  "examples": [
    {
      "type": "machine_max:item_storage",
      "model": "machine_max:default_trunk"
    }
  ]
}