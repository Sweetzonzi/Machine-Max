{
  "$schema": "../../docs/zh_cn/schemas/part_definition_schema.json",
  "icon": "machine_max:textures/icon/wine_fox/wine_fox_gt_wheel_icon.png",//(可选, 留空会使用紫黑格子)部件图标路径
  "vehicle_durability_rate": 1.0,//(可选, 默认1.0)载具耐久贡献系数, 部件耐久度按此比例贡献给载具总耐久度
  "vehicle_damage_rate": 0.5,//(可选, 默认1.0)常态载具伤害传导系数, 部件受到伤害时按此比例传导给载具
  "vehicle_damage_rate_destroyed": 0.1,//(可选, 默认0.5)部件被摧毁后的载具伤害传导系数, 部件被摧毁后受到伤害时按此比例传导给载具
  "max_stack_size": 4,
  "variants": {//部件变体列表, 支持单值或多键值对
    "left": {//变体名称
      "model": "machine_max:wine_fox.geo", //模型路径
      "textures": "machine_max:textures/part/wine_fox/wine_fox.png",
      "animations": "machine_max:empty", //(可选, 留空则不播放动画)动画路径
      "tags": ["wheel", "wine_fox", "left", "gt"],//(可选)部件标签列表
      "sub_parts": {//零件(子部件)列表
        "sub_part.machine_max.main": {//零件(子部件)名称
          "start_bone": "GtLeftFrontWheel", // (可选，默认空)起始骨骼名称，此骨骼及其包含的骨骼才会被作为零件的渲染与定义用模型
          "durability": 80.0,//(可选, 默认20.0)部件基础生命值, 降至0时部件的所有子系统会瘫痪
          "mass": 35.0,//零件质量(kg)
          "block_collision": "ground",//(可选, 默认true)地形碰撞模式:true(与所有方块碰撞),ground(仅与低于部件最低位置的地面方块碰撞),false(不与任何方块碰撞)
          "collision_height": 1.5,//(可选)碰撞检测高度(m), 遭遇的障碍小于此高度时不与障碍发生碰撞(方块碰撞模式需要为ground), 默认所有障碍均碰撞
          "climb_assist": true,//(可选, 默认false)是否开启自动攀爬辅助, 开启后会在自动攀爬时提供额外的速度
          "hit_boxes": {//键:骨骼名称, 会寻找名称匹配的骨骼, 并根据其中的方块创建不同形状的碰撞体, 以及将此骨骼下的定位器储存起来供子系统等使用
            "LeftGtWheelCollision": {//骨骼名称, 会寻找名称匹配的骨骼, 并根据其中的方块创建不同形状的碰撞体
              "type": "wheel",//碰撞形状类型, 支持box、sphere、cylinder、wheel
              "friction": [2.0, 2.2, 1.0],//(可选, 默认[0.5, 0.5, 0.5])各向异性摩擦系数[侧向, 前向, 疑似无用]
              "slip_adaptation": 0.7,//(可选, 默认0.5)滑动适应性系数(0~1), 该属性可削弱打滑时的摩擦系数降低效果, 提升抓地力
              "rolling_friction": 0.2,//(可选, 默认0.2)滚动摩擦系数, 影响滚动阻力
              "restitution": 0.2,//(可选, 默认0.1)弹性系数, 0为完全非弹性碰撞, 1为完全弹性碰撞, 碰撞时以此系数和相碰物体的弹性系数之积作为最终弹性系数
              "block_damage_factor": 0.05, //(可选, 默认1.0)方块破坏系数, 0为无法破坏方块, 1为造成全额伤害, 调整此系数以改变对方块的破坏能力
              "impact_modifiers": [
                {
                  "operation": "multiply",
                  "value": 0.1,
                  "condition": {
                    "type": "damage_tag",
                    "id": "c:is_impact"
                  }
                },
                {
                  "operation": "add",
                  "value": -2.0,
                  "condition": {
                    "type": "damage_tag",
                    "id": "c:is_impact"
                  }
                }
              ],
              "damage_modifiers": [
                {
                  "operation": "multiply", // 运算符, 支持add和multiply, add则将value加到传入的数值上, multiply则乘以value
                  "value": 0.1, // 修正量, 根据operation不同, 以不同的行为影响传入的数值, 这里会将撞击伤害削减至0.1倍
                  "condition": {
                    "type": "damage_tag", // 判断伤害是否属于某个标签
                    "id": "c:is_impact" // 伤害标签注册名
                  }
                },
                {
                  "operation": "add", // 运算符, 支持add和multiply, add则将value加到传入的数值上, multiply则乘以value
                  "value": -2.0, // 修正量, 根据operation不同, 以不同的行为影响传入的数值, 这里会将撞击伤害削减5点（不小于0）
                  "condition": {
                    "type": "damage_tag", // 判断伤害是否属于某个标签
                    "id": "c:is_impact" // 伤害标签注册名
                  }
                },
                {
                  "operation": "multiply", // 运算符, 支持add和multiply, add则将value加到传入的数值上, multiply则乘以value
                  "value": 0.05, // 修正量, 根据operation不同, 以不同的行为影响传入的数值, 这里会将浆果丛造成的削减至5%, 防止帧伤快速摧毁载具
                  "condition": {
                    "type": "damage_type",
                    "id": "minecraft:sweet_berry_bush"
                  }
                },
                {
                  "operation": "multiply", // 运算符, 支持add和multiply, add则将value加到传入的数值上, multiply则乘以value
                  "value": 0.05, // 修正量, 根据operation不同, 以不同的行为影响传入的数值, 这里会将史莱姆造成的削减至5%, 防止帧伤快速摧毁载具
                  "condition": {
                    "type": "entity_type",
                    "id": "minecraft:slime"
                  }
                },
                {
                  "operation": "multiply", // 运算符, 支持add和multiply, add则将value加到传入的数值上, multiply则乘以value
                  "value": 0.1, // 修正量, 根据operation不同, 以不同的行为影响传入的数值, 这里会将岩浆怪造成的削减至10%, 防止帧伤快速摧毁载具
                  "condition": {
                    "type": "entity_type",
                    "id": "minecraft:magma_cube"
                  }
                }
              ]
            }
          },
          "connectors": {//子部件用于与其他零件连接的连接点列表
            "connector.machine_max.chassis_connection": {//连接点名称
              "locator": "left_gt_wheel_chassis",//Locator名称, 会寻找名称匹配的Locator, 以其位置与姿态作为连接点的位置和姿态
              "type": "Simple", //连接点类型, 支持Simple和Advanced
              "direction": "xp",
              "integrity": 30.0,//(可选, 默认20.0)连接点结构完整度, 连接点可承受不高于此数值的冲击力而不脱落, 冲击力来自伤害(已实装)或关节应力(暂未实装)
              "impact_reduction": 3.0, //(可选, 默认2.0)连接点的冲击减免值, 在计算部件击落前应用, 可将冲击削减至0以完全避免对结构完整性的影响
              "impact_multiplier": 0.8 //(可选, 默认1.0)连接点的冲击吸收率, 在计算部件击落前, 应用冲击减免后应用, 大于1将使连接点更容易断开
            }
          },
          "projected_area": [0.82, 0.40, 0.40],
          "hydrodynamics": {
            "": {
              "front_drag": [0.0, 0.35],
              "back_drag": [0.0, 0.35],
              "left_drag": [0.0, 0.35],
              "right_drag": [0.0, 0.35],
              "up_drag": [0.0, 0.35],
              "down_drag": [0.0, 0.35]
            }
          }
        }
      }
    },
