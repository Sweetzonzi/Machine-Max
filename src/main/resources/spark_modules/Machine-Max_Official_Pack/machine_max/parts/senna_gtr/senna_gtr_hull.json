{
  "$schema": "../../docs/zh_cn/schemas/part_definition_schema.json",
  "icon": "machine_max:textures/icon/senna_gtr/senna_gtr_hull_icon.png",
  "vehicle_durability_rate": 0.6,
  "vehicle_damage_rate": 1.0,
  "vehicle_damage_rate_destroyed": 0.1,
  "variants": {
    "front": {
      "model": "machine_max:senna_gtr_front_hull.geo",
      "textures": "machine_max:textures/part/senna_gtr.png",
      "animations": "machine_max:senna_gtr",
      "tags": ["hull", "senna_gtr", "front"],
      "sub_parts": {
        "sub_part.machine_max.main": {
          "durability": 120.0,
          "mass": 200.0,
          "block_collision": "ground",
          "collision_height": 1.5,
          "hit_boxes": {
            "Collision": { //值:碰撞形状属性
              "id": "part",
              "type": "box", //碰撞形状类型, 支持box、sphere、cylinder
              "un_penetrate_damage_factor": 0.5 //(可选, 默认0.0)攻击未能完全击穿护甲时的伤害系数, 公式为:攻击伤害*(穿深/等效护甲)^un_penetrate_damage_factor, 此项为0.0时未击穿则无伤害
            }
          },
          "connectors": {
            "connector.machine_max.chassis_front": {
              "locator": "hull_chassis_front",
              "type": "Simple",
              "direction": "yn",
              "integrity": 50.0
            },
            "connector.machine_max.left_door_axis": {
              "locator": "hull_left_door_axis",
              "type": "Advanced",
              "direction": "yp",
              "required_tags": ["left", "door"],
              "integrity": 20.0,
              "joint_attrs": {
                "zr": {
                  "lower_limit": 0.0,
                  "upper_limit": 80.0,
                  "equilibrium": 80,
                  "stiffness": 500,
                  "damping": 200
                }
              }
            },
            "connector.machine_max.right_door_axis": {
              "locator": "hull_right_door_axis",
              "type": "Advanced",
              "direction": "yp",
              "required_tags": ["right", "door"],
              "integrity": 20.0,
              "joint_attrs": {
                "zr": {
                  "lower_limit": -80.0,
                  "upper_limit": 0.0,
                  "equilibrium": -80,
                  "stiffness": 500,
                  "damping": 200
                }
              }
            }
          },
          "projected_area": [8.6, 13.9, 6.5],
          "hydro_priority": 10,
          "hydrodynamics": {
            "": {
              "front_drag": [0.0, 0.3],
              "back_drag": [0.0, 0.5]
            }
          }
        }
      }
    },
    "back": {
      "model": "machine_max:senna_gtr_back_hull.geo",
      "textures": "machine_max:textures/part/senna_gtr.png",
      "animations": "machine_max:senna_gtr",
      "tags": ["hull", "senna_gtr", "back"],
      "sub_parts": {
        "sub_part.machine_max.main": {
          "durability": 120.0,
          "mass": 200.0,
          "block_collision": "ground",
          "collision_height": 1.5,
          "hit_boxes": {
            "Collision": { //值:碰撞形状属性
              "id": "part",
              "type": "box", //碰撞形状类型, 支持box、sphere、cylinder
              "un_penetrate_damage_factor": 0.5 //(可选, 默认0.0)攻击未能完全击穿护甲时的伤害系数, 公式为:攻击伤害*(穿深/等效护甲)^un_penetrate_damage_factor, 此项为0.0时未击穿则无伤害
            }
          },
          "connectors": {
            "connector.machine_max.chassis_back": {
              "locator": "hull_chassis_back",
              "type": "Simple",
              "direction": "yn",
              "integrity": 50.0
            },
            "connector.machine_max.left_door_lock": {
              "locator": "hull_left_door_lock",
              "type": "Simple",
              "required_tags": ["left", "door"],
              "integrity": 20.0
            },
            "connector.machine_max.right_door_lock": {
              "locator": "hull_right_door_lock",
              "type": "Simple",
              "required_tags": ["right", "door"],
              "integrity": 20.0
            }
          },
          "projected_area": [8.6, 13.9, 6.5],
          "hydro_priority": 10,
          "hydrodynamics": {
            "front_hydro": { // 车头气动计算点，主要提供前、上和侧向的阻力
              "front_drag": [0.0, 0.3],
              "back_drag": [],
              "up_drag": [0.0, 0.25], // 两个气动提供向上的阻力计算点，因此阻力系数取一半，下同
              "down_drag": [],
              "left_drag": [0.0, 0.25],
              "right_drag": [0.0, 0.25]
            },
            "back_hydro": { // 车尾气动计算点，主要提供后、上和侧向的阻力
              "front_drag": [],
              "back_drag": [0.0, 0.4], // 启动修型稍差，阻力系数略大
              "up_drag": [0.0, 0.25], // 两个气动提供向上的阻力计算点，因此阻力系数取一半，下同
              "down_drag": [],
              "left_drag": [0.0, 0.25],
              "right_drag": [0.0, 0.25]
            },
            "DownHydro": { // 车底气动计算点组，包含两个气动计算点，提供下向的阻力
              "scale": 0.5, // 包含两个气动计算点，因此总阻力值需要缩小一半
              "front_drag": [],
              "back_drag": [],
              "up_drag": [],
              "down_drag": [0.0, 0.5],
              "left_drag": [],
              "right_drag": []
            }
          }
        }
      }
    }
  }
}