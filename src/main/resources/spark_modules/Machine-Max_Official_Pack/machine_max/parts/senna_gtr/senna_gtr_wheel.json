{
  "$schema": "../../docs/zh_cn/schemas/part_definition_schema.json",
  "vehicle_durability_rate": 1.0,//(可选, 默认1.0)载具耐久贡献系数, 部件耐久度按此比例贡献给载具总耐久度
  "vehicle_damage_rate": 0.5,//(可选, 默认1.0)常态载具伤害传导系数, 部件受到伤害时按此比例传导给载具
  "vehicle_damage_rate_destroyed": 0.1,//(可选, 默认0.5)部件被摧毁后的载具伤害传导系数, 部件被摧毁后受到伤害时按此比例传导给载具
  "variants": {//部件变体列表, 支持单值或多键值对
    "left_front": {//变体名称
      "icon": "machine_max:textures/icon/senna_gtr/senna_gtr_wheel_icon.png",
      "model": "machine_max:senna_gtr_wheel_left_front.geo",
      "textures": "machine_max:textures/part/senna_gtr.png",
      "animations": "machine_max:empty", //(可选, 留空则不播放动画)动画路径
      "tags": ["wheel", "senna_gtr", "left", "front"],//(可选)部件标签列表
      "sub_parts": {
        "sub_part.machine_max.main": {
          "durability": 80.0,
          "mass": 32.0,
          "block_collision": "ground",
          "collision_height": 1.5,
          "climb_assist": true,
          "hit_boxes": {
            "Collision": {
              "type": "wheel",
              "friction": [1.4, 2.0, 1.0],//(可选, 默认[0.5, 0.5, 0.5])各向异性摩擦系数[侧向, 前向, 疑似无用]
              "slip_adaptation": 0.5,//(可选, 默认0.5)滑动适应性系数(0~1), 该属性可削弱打滑时的摩擦系数降低效果, 提升抓地力
              "rolling_friction": 0.05,//(可选, 默认0.2)滚动摩擦系数, 影响滚动阻力
              "restitution": 0.05,//(可选, 默认0.1)弹性系数, 0为完全非弹性碰撞, 1为完全弹性碰撞, 碰撞时以此系数和相碰物体的弹性系数之积作为最终弹性系数
              "block_damage_factor": 0.05, //(可选, 默认1.0)方块破坏系数, 0为无法破坏方块, 1为造成全额伤害, 调整此系数以改变对方块的破坏能力
              "impact_modifiers": [
                {
                  "operation": "multiply",
                  "value": 0.1,
                  "condition": {
                    "type": "damage_tag",
                    "id": "machine_max:is_impact"
                  }
                },
                {
                  "operation": "add",
                  "value": -2.0,
                  "condition": {
                    "type": "damage_tag",
                    "id": "machine_max:is_impact"
                  }
                }
              ],
              "damage_modifiers": [
                {
                  "operation": "multiply",
                  "value": 0.1,
                  "condition": {
                    "type": "damage_tag",
                    "id": "machine_max:is_impact"
                  }
                },
                {
                  "operation": "add",
                  "value": -2.0,
                  "condition": {
                    "type": "damage_tag",
                    "id": "machine_max:is_impact"
                  }
                },
                {
                  "operation": "multiply",
                  "value": 0.05,
                  "condition": {
                    "type": "damage_type",
                    "id": "minecraft:sweet_berry_bush"
                  }
                },
                {
                  "operation": "multiply",
                  "value": 0.05,
                  "condition": {
                    "type": "entity_type",
                    "id": "minecraft:slime"
                  }
                },
                {
                  "operation": "multiply",
                  "value": 0.1,
                  "condition": {
                    "type": "entity_type",
                    "id": "minecraft:magma_cube"
                  }
                }
              ]
            }
          },
          "connectors": {
            "connector.machine_max.chassis_connection": {
              "locator": "chassis_connection",
              "type": "Simple",
              "direction": "xp",
              "integrity": 30.0,
              "impact_reduction": 3.0,
              "impact_multiplier": 0.8
            }
          },
          "projected_area": [0.71, 0.40, 0.40],
          "hydrodynamics": {
            "": {
              "front_drag": [0.0, 0.35],
              "back_drag": [0.0, 0.35],
              "left_drag": [0.0, 0.35],
              "right_drag": [0.0, 0.35],
              "up_drag": [0.0, 0.35],
              "down_drag": [0.0, 0.35]
            }
