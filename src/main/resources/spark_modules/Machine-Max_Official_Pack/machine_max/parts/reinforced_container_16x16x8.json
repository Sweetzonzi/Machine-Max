{
  "$schema": "../docs/zh_cn/schemas/part_definition_schema.json",
  "vehicle_durability_rate": 0.0,//(可选, 默认0.8)载具耐久贡献系数, 部件耐久度按此比例贡献给载具总耐久度
  "vehicle_damage_rate": 0.0,//(可选, 默认1.0)常态载具伤害传导系数, 部件受到伤害时按此比例传导给载具
  "vehicle_damage_rate_destroyed": 0.0,//(可选, 默认0.1)部件被摧毁后的载具伤害传导系数, 部件被摧毁后受到伤害时按此比例传导给载具
  "variants": {//部件变体列表, 支持单值或多键值对
    "icon": "machine_max:textures/icon/reinforced_container_16x16x8_icon.png",//(可选, 留空会使用紫黑格子)部件图标路径
    "model": "machine_max:container_16x16x8.geo", //模型路径
    "textures": "machine_max:textures/part/reinforced_container_16x16x8.png",
    "animations": "machine_max:empty", //(可选, 留空则不播放动画)动画路径
    "tags": ["reinforced", "storage"],//(可选)部件标签列表
    "sub_parts": {//零件(子部件)列表
      "sub_part.machine_max.main": {//零件(子部件)名称
        "durability": 150.0,//(可选, 默认20.0)部件基础生命值, 降至0时部件的所有子系统会瘫痪
        "mass": 30.0,//零件质量(kg)
        "block_collision": "true",//(可选, 默认true)地形碰撞模式:true(与所有方块碰撞),ground(仅与低于部件最低位置的地面方块碰撞),false(不与任何方块碰撞)
        "collision_height": 0,//(可选)碰撞检测高度(m), 遭遇的障碍小于此高度时不与障碍发生碰撞(方块碰撞模式需要为ground), 默认所有障碍均碰撞
        "climb_assist": false,//(可选, 默认false)是否开启自动攀爬辅助, 开启后会在自动攀爬时提供额外的速度
        "hit_boxes": {//键:骨骼名称, 会寻找名称匹配的骨骼, 并根据其中的方块创建不同形状的碰撞体, 以及将此骨骼下的定位器储存起来供子系统等使用
          "Shape": {//骨骼名称, 会寻找名称匹配的骨骼, 并根据其中的方块创建不同形状的碰撞体
            "type": "box",//碰撞形状类型, 支持box、sphere、cylinder
            "friction": [2.5, 2.5, 2.5],//(可选, 默认[0.5, 0.5, 0.5])各向异性摩擦系数[侧向, 前向, 疑似无用]
            "slip_adaptation": 0,//(可选, 默认0.5)滑动适应性系数(0~1), 该属性可削弱打滑时的摩擦系数降低效果, 提升抓地力
            "rolling_friction": 0.5,//(可选, 默认0.2)滚动摩擦系数, 影响滚动阻力
            "restitution": 0.2,//(可选, 默认0.1)弹性系数, 0为完全非弹性碰撞, 1为完全弹性碰撞, 碰撞时以此系数和相碰物体的弹性系数之积作为最终弹性系数
            "block_damage_factor": 1.0, //(可选, 默认1.0)方块破坏系数, 0为无法破坏方块, 1为造成全额伤害, 调整此系数以改变对方块的破坏能力
            "impact_modifiers": [], // (可选, 默认为空列表, 造成多少伤害就对连接点施加多少冲击) 冲击修正器, 将受到的伤害按照一定规则转换为冲击数值施加到各连接点
            "penetration_modifiers": [ // (可选, 默认在传入的伤害不包含穿深时, 以伤害的0.5倍作为穿深) 穿深修正器, 根据受到的伤害调整其穿深。若伤害不带穿深数据, 则传入伤害值, 否则传入穿深
              {
                "operation": "multiply", // 运算符, 支持add和multiply, add则将value加到传入的数值上, multiply则乘以value
                "value": 0.5, // 修正量, 根据operation不同, 以不同的行为影响传入的数值, 这里会将伤害的0.5倍作为穿深
                "condition": { // 修改器生效条件, 若不满足则不生效, 不影响传入的数值
                  "type": "not", // 条件类型, 支持always、damage_type、damage_tag、entity_type、entity_tag、not、and、or
                  "condition": { // not条件需要一个condition字段, 里面可以填入其他条件, 会将其结果反转
                    "type": "damage_tag", // 判断伤害是否含有指定标签
                    "tag": "machine_max:has_pen_depth" // 标签名
                  }
                }
              }
            ],
            "damage_modifiers": [// (可选, 默认忽视5以下的撞击伤害, 大幅减弱史莱姆等每帧造成的伤害) 伤害修正器, 将受到的伤害按照一定规则转换为伤害数值。若伤害不带伤害数据, 则传入伤害值, 否则传入伤害数据
              {
                "operation": "add", // 运算符, 支持add和multiply, add则将value加到传入的数值上, multiply则乘以value
                "value": -5.0, // 修正量, 根据operation不同, 以不同的行为影响传入的数值, 这里会将撞击伤害削减5点（不小于0）
                "condition": {
                  "type": "damage_type", // 判断伤害是否为某个类型
                  "id": "minecraft:fly_into_wall" // 伤害类型注册名
                }
              },
              {
                "operation": "multiply", // 运算符, 支持add和multiply, add则将value加到传入的数值上, multiply则乘以value
                "value": 0.05, // 修正量, 根据operation不同, 以不同的行为影响传入的数值, 这里会将浆果丛造成的削减至5%, 防止帧伤快速摧毁载具
                "condition": {
                  "type": "damage_type",
                  "id": "minecraft:sweet_berry_bush"
                }
              },
              {
                "operation": "multiply", // 运算符, 支持add和multiply, add则将value加到传入的数值上, multiply则乘以value
                "value": 0.05, // 修正量, 根据operation不同, 以不同的行为影响传入的数值, 这里会将史莱姆造成的削减至5%, 防止帧伤快速摧毁载具
                "condition": {
                  "type": "entity_type",
                  "id": "minecraft:slime"
                }
              },
              {
                "operation": "multiply", // 运算符, 支持add和multiply, add则将value加到传入的数值上, multiply则乘以value
                "value": 0.05, // 修正量, 根据operation不同, 以不同的行为影响传入的数值, 这里会将岩浆怪造成的削减至10%, 防止帧伤快速摧毁载具
                "condition": {
                  "type": "entity_type",
                  "id": "minecraft:magma_cube"
                }
              },
              {
                "operation": "add", // 运算符, 支持add和multiply, add则将value加到传入的数值上, multiply则乘以value
                "value": -1.0, // 全局减伤, 将所有伤害削减1点（不小于0）
                "condition": {
                  "type": "always" // 此条件永远判定通过, 用于全局减伤
                }
              },
              {
                "operation": "multiply", // 运算符, 支持add和multiply, add则将value加到传入的数值上, multiply则乘以value
                "value": 0.8, // 全局减伤, 将所有伤害削减20%
                "condition": {
                  "type": "always" // 此条件永远判定通过, 用于全局减伤
                }
              }
            ]
          }
        },
        "interact_boxes": {//交互判定区列表
          "interact.machine_max.reinforced_container_16x16x8": {//键:交互判定区名称
            "bone": "Interact",//骨骼名称, 会寻找名称匹配的骨骼, 以其内部方块的位置与姿态作为交互判定区体积的位置和姿态
            "signal_targets": {
              "trunk_interact": ["subsystem.machine_max.reinforced_container_16x16x8"] //将交互信号转发给与车体连接的连接点
            },
            "interact_mode": "accurate" //(可选, 默认fast)交互模式, fast为玩家碰撞箱与交互区碰撞时按下交互键触发, accurate为玩家瞄准交互区按下交互键触发
          }
        },
        "subsystems": {//(可选)子系统配置
          "subsystem.machine_max.reinforced_container_16x16x8": {
            "type": "machine_max:item_storage",//子系统类型
            "definition": "machine_max:container_16x16x8"//子系统型号, 需要与子系统类型相匹配
          }
        },
        "connectors": {//子部件用于与其他零件连接的连接点列表
          "connector.machine_max.up": {//连接点名称
            "locator": "up",//Locator名称, 会寻找名称匹配的Locator, 以其位置与姿态作为连接点的位置和姿态
            "type": "Simple", //连接点类型, 支持Simple和Advanced
            "direction": "yp",
            "integrity": 40.0,//(可选, 默认20.0)部件基础结构完整度, 部件可承受不高于此数值的冲击力而不脱落, 冲击力来自伤害(已实装)或关节应力(暂未实装)
            "impact_reduction": 3.0, //(可选, 默认2.0)连接点的冲击减免值, 在计算部件击落前应用, 可将冲击削减至0以完全避免对结构完整性的影响
            "impact_multiplier": 0.8 //(可选, 默认1.0)连接点的冲击吸收率, 在计算部件击落前, 应用冲击减免后应用, 大于1将使连接点更容易断开
          },
          "connector.machine_max.down": {//连接点名称
            "locator": "down",//Locator名称, 会寻找名称匹配的Locator, 以其位置与姿态作为连接点的位置和姿态
            "type": "Simple", //连接点类型, 支持Simple和Advanced
            "direction": "yn"
          }
        }
      }
    }
  }
}