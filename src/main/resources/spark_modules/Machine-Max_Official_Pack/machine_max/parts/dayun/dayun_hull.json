{
  "$schema": "../../docs/zh_cn/schemas/part_definition_schema.json",
  "icon": "machine_max:textures/icon/dayun/dayun_hull_icon.png",
  "vehicle_durability_rate": 0.6,
  "vehicle_damage_rate": 1.0,
  "vehicle_damage_rate_destroyed": 0.1,
  "variants": {
    "model": "machine_max:dayun_hull.geo",
    "textures": { //贴图路径列表
      "print.machine_max.dayun.1": "machine_max:textures/part/dayun/dayun.png",
      "print.machine_max.dayun.2": "machine_max:textures/part/dayun/dayun2.png",
      "print.machine_max.dayun.3": "machine_max:textures/part/dayun/dayun3.png",
      "print.machine_max.dayun.4": "machine_max:textures/part/dayun/dayun4.png",
      "print.machine_max.dayun.5": "machine_max:textures/part/dayun/dayun5.png",
      "print.machine_max.dayun.6": "machine_max:textures/part/dayun/dayun6.png"
    },
    "animations": "machine_max:empty", //(可选, 留空则不播放动画)动画路径
    "tags": ["machine_max:dayun", "machine_max:hull"], //(可选, 默认[])部件标签列表
    "sub_parts": { //零件(子部件)列表
      "sub_part.machine_max.main": { //零件(子部件)名称
        "durability": 1000.0, //(可选, 默认20.0)部件基础生命值, 降至0时部件的所有子系统会瘫痪
        "mass": 1000.0, //零件质量(kg)
        "block_collision": "ground", //(可选)地形碰撞模式:true(默认, 与所有方块碰撞),ground(仅与部件之下的地面方块碰撞),false(不与任何方块碰撞)
        "collision_height": 1.0, //(可选)碰撞检测高度(m), 遭遇的障碍小于此高度时不与障碍发生碰撞(方块碰撞模式需要为ground), 默认所有障碍均碰撞
        "hit_boxes": { //键:骨骼名称, 会寻找名称匹配的骨骼, 并根据其中的方块创建不同形状的碰撞体
          "collision": { //值:碰撞形状属性
            "type": "box", //碰撞形状类型, 支持box、sphere、cylinder
            "material": "machine_max:structural_steel",
            "thickness": 10
          },
          "engine": { //值:碰撞形状属性
            "type": "box", //碰撞形状类型, 支持box、sphere、cylinder
            "subsystem": "engine",
            "material": "machine_max:structural_steel",
            "thickness": 2 //(可选, 默认1)等效护甲厚度, 单位mm, 减免伤害并控制碰撞时的能量分配情况
          }
        },
        "subsystems": {
          "subsystem.machine_max.car_controller": {
            "type": "machine_max:car_controller", //子系统类型
            "definition": "machine_max:dayun_car_controller", //子系统型号, 需要与子系统类型相匹配
            "engine_outputs": {
              "engine_control": [
                "subsystem.machine_max.engine"
              ]
            },
            "wheel_outputs": {
              "wheel_control": [
                "connector.machine_max.chassis_connection"
              ]
            },
            "gearbox_outputs": {
              "gearbox_control": [
                "connector.machine_max.chassis_connection"
              ]
            },
            "speed_outputs": { //(可选, 默认将移动速度(m/s)发至部件和载具的vehicle_speed频道)移动速度信号输出频道及目标
              "vehicle_speed": [
                "vehicle"
              ]
            },
            "throttle_outputs": { //(可选, 默认将油门[0,1]发至部件和载具的throttle频道)油门信号输出频道及目标
              "throttle": [
                "vehicle"
              ]
            },
            "brake_outputs": { //(可选, 默认将制动程度[0,1]发至部件和载具的brake频道)制动信号输出频道及目标
              "brake": [
                "vehicle"
              ]
            },
            "steering_outputs": { //(可选, 默认将转向程度[-1,1]发至部件和载具的steering频道)转向角度信号输出频道及目标
              "steering": [
                "vehicle"
              ]
            },
            "handbrake_outputs": { //(可选, 默认将手刹程度[0,1]发至部件和载具的handbrake频道)手刹器开关信号输出频道及目标
              "handbrake": [
                "vehicle"
              ]
            }
          },
          "subsystem.machine_max.engine": {
            "type": "machine_max:engine", //子系统类型
            "definition": "machine_max:dayun_engine", //子系统型号, 需要与子系统类型相匹配
            "power_output": "connector.machine_max.chassis_connection", //功率输出目标, 可填写任意本部件内其他子系统名称、部件连接点名称, 或“part”, 或“vehicle”
            "speed_outputs": { //转速信号输出目标及信号名称, 同上, 但可以有多个
              "engine_speed": [
                "vehicle"
              ]
            }
          }
        },
        "interact_boxes": { //交互判定区列表
          "interact.machine_max.left_door": { //键:交互判定区名称
            "bone": "LeftDoor", //骨骼名称, 会寻找名称匹配的骨骼, 以其内部方块的位置与姿态作为交互判定区体积的位置和姿态
            "signal_targets": {
              "left_door_interact": [
                "connector.machine_max.left_seat"
              ] //将交互信号转发给与车体连接的连接点
            },
            "interact_mode": "fast" //(可选, 默认fast)交互模式, fast为玩家碰撞箱与交互区碰撞时按下交互键触发, accurate为玩家瞄准交互区按下交互键触发
          },
          "interact.machine_max.right_door": { //键:交互判定区名称
            "bone": "RightDoor", //骨骼名称, 会寻找名称匹配的骨骼, 以其内部方块的位置与姿态作为交互判定区体积的位置和姿态
            "signal_targets": {
              "right_door_interact": [
                "connector.machine_max.right_seat"
              ] //将交互信号转发给与车体连接的连接点
            },
            "interact_mode": "fast" //(可选, 默认fast)交互模式, fast为玩家碰撞箱与交互区碰撞时按下交互键触发, accurate为玩家瞄准交互区按下交互键触发
          }
        },
        "connectors": { //子部件用于与其他零件连接的连接点列表
          "connector.machine_max.chassis_connection": { //连接点名称
            "locator": "chassis_locator", //Locator名称, 会寻找名称匹配的Locator, 以其位置与姿态作为连接点的位置和姿态
            "definition": "machine_max:fixed_down"
          },
          "connector.machine_max.left_seat": {
            "locator": "left_seat",
            "definition": "machine_max:fixed_down",
            "signal_targets": {
              "move_control": [
                "subsystem.machine_max.car_controller" //向控制器传输标准移动输入信号, 如转向、加速、刹车等
              ],
              "regular_control": [
                "subsystem.machine_max.car_controller"
              ] //向车辆控制器传输一般按键输入信号, 如换挡、离合器控制等
            }
          },
          "connector.machine_max.right_seat": {
            "locator": "right_seat",
            "definition": "machine_max:fixed_up"
          },
          "connector.machine_max.front": {
            "locator": "front",
            "definition": "machine_max:fixed_up"
          }
        },
        "hydro_priority": 1, //(可选, 默认0)空气阻力计算优先级, 值越大优先级越高, 优先级高的部件不会被优先级低的部件阻挡而导致阻力系数发生变化
        "hydrodynamics": { //(可选, 默认单点质心位置计算流体动力)流体动力计算定位点列表, 键值对的键名为空字符串时表示以质心位置计算
          "": { //流体动力计算点定位器名, 空字符串代表质心
            "scale": 1.0, //(可选, 默认1.0)整体上缩放流体动力的作用效果, 以多点而非单点计算流体动力时可相应调整此数值以确保数值可靠
            "transonic_amplifier": 5.0, //(可选, 默认5.0)跨声速段的阻力缩放因子, 当来流速度达到0.8~1.2马赫时, 阻力系数会逐渐从1x缩放到此倍数
            "front_drag": [
              0.1,
              0.45
            ], //(可选, 默认[0.0,1.0])前向各阶阻力系数, 默认值下部件在前进时受到0.5*ρ*S*(0.1v+1.0v^2)的阻力, 其中ρ为空气密度, S为Z向(前后方向)投影面积, v为前进速度
            "back_drag": [
              0.1,
              0.7
            ], //(可选, 默认[0.0,1.0])后向各阶阻力系数, 默认值下部件在后退时受到0.5*ρ*S*(0.1v+1.0v^2)的阻力, 其中ρ为空气密度, S为Z向(前后方向)投影面积, v为后退速度
            "left_drag": [
              0.1,
              1.0
            ], //(可选, 默认[0.0,1.0])左向各阶阻力系数, 默认值下部件在左移时受到0.5*ρ*S*(0.1v+1.0v^2)的阻力, 其中ρ为空气密度, S为Y向(前后方向)投影面积, v为左移速度
            "right_drag": [
              0.1,
              1.0
            ], //(可选, 默认[0.0,1.0])右向各阶升力系数, 默认值下部件在右移时受到0.5*ρ*S*(0.1v+1.0v^2)的阻力, 其中ρ为空气密度, S为Y向(前后方向)投影面积, v为右移速度
            "up_drag": [
              0.1,
              1.0
            ], //(可选, 默认[0.0,1.0])上向各阶阻力系数, 默认值下部件在上升时受到0.5*ρ*S*(0.1v+1.0v^2)的阻力, 其中ρ为空气密度, S为X向(前后方向)投影面积, v为上升速度
            "down_drag": [
              0.1,
              1.0
            ] //(可选, 默认[0.0,1.0])下向各阶阻力系数, 默认值下部件在坠落时受到0.5*ρ*S*(0.1v+1.0v^2)的阻力, 其中ρ为空气密度, S为X向(前后方向)投影面积, v为下降速度
          }
        }
      }
    }
  }
}