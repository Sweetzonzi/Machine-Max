{
  "$schema": "../../docs/zh_cn/schemas/subsystem/subsystem_static_attr.schema.json",
  "type": "machine_max:wheel_driver",
  "basic_durability": 700, //(可选, 默认20.0)子系统基础耐久度, 降至0时会瘫痪
  "roll": {//(可选)轮胎滚动相关属性, 默认最大驱动力矩10000N*m, 最大刹车力矩3500N*m, 最大手刹车力矩0N*m, 最大转速3140rad/s, 不反馈转速值到任何频道的任何目标
    "max_drive_force": 28000.0, //(可选, 默认10000)最大驱动力矩(N*m)
    "max_brake_force": 20000.0, //(可选, 默认3500)最大刹车力矩(N*m)
    "max_hand_brake_force": 35000.0, //(可选, 默认0)最大手刹车力矩(N*m)
    "max_speed": 3540.0 //(可选, 默认3140)最大转速(rad/s)
  },
  "steering": {//(可选)轮胎转向相关属性, 默认最大转向力矩4000N*m, 最大转速3.14rad/s, 不反馈转角值到任何频道的任何目标
    "max_force": 0.0,
    "max_speed": 0.0
  },
  "abs_enabled": true, //(可选, 默认false)是否启用ABS
  "abs_target_slip_ratio": 0.15, //(可选, 默认0.15)ABS目标滑移率
  "abs_wheel_radius": 0.5, //(可选, 默认0.3)轮胎半径(m)
  "control_inputs": ["wheel_control", "move_control"], //(可选, 默认["wheel_control", "move_control"])接收的控制信号的频道列表, 优先级递减
  "sounds": {
    "brake_on": {
      "sound_id": "machine_max:subsystem.wheel_driver.air_brake_on",
      "range": 16
    },
    "brake_off": {
      "sound_id": "machine_max:subsystem.wheel_driver.air_brake_off",
      "range": 16
    }
  }
}