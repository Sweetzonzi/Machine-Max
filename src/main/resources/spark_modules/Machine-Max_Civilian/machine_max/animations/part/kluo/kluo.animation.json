{
	"format_version": "1.8.0",
	"animations": {
		"parallel0": {
			"loop": true,
			"bones": {
				"FXP": {
					"rotation": [0, 0, "-(local.connector_rotation('connector.machine_max.hull_left_front_wheel', 1) + local.connector_rotation('connector.machine_max.hull_right_front_wheel', 1))*2"]
				},
				"Ym": {
					"position": [0, 0, "-1.0*global.get('throttle')"]
				},
				"Sc": {
					"position": [0, 0, "-1.0*global.get('brake')"]
				},
				"PointerArmor": {
					"rotation": [0, 0, "-225*(math.abs(global.get('engine_speed')??0)*30/math.pi)/9000"]
				},
				"PointerFuel": {
					"rotation": [0, 0, 180]
				},
				"PointerSpeed": {
					"rotation": [0, 0, "-225*(math.abs(global.get('vehicle_speed')??0)/33)"]
				},
				"FrontGlass": {
					"scale": "!local.subsystem_destroyed('subsystem.machine_max.front_glass')"
				},
				"ysmGlowTrunkRightLight": {
					"scale": "local.subsystem_active('subsystem.machine_max.right_tail_light')"
				},
				"ysmGlowTrunkLeftLight": {
					"scale": "local.subsystem_active('subsystem.machine_max.left_tail_light')"
				},
				"LeftBackGlass": {
					"scale": "!local.subsystem_destroyed('subsystem.machine_max.left_back_glass')"
				},
				"RightBackGlass": {
					"scale": "!local.subsystem_destroyed('subsystem.machine_max.right_back_glass')"
				},
				"ysmGlowLeftRearLight": {
					"scale": "local.subsystem_active('subsystem.machine_max.left_tail_light')"
				},
				"ysmGlowRightRearLight": {
					"scale": "local.subsystem_active('subsystem.machine_max.right_tail_light')"
				},
				"ysmGlowLeftFrontHeadLight": {
					"scale": "local.subsystem_active('subsystem.machine_max.left_main_light') && !local.has_connector('connector.machine_max.left_front_light')"
				},
				"ysmGlowRightFrontHeadLight": {
					"scale": "local.subsystem_active('subsystem.machine_max.right_main_light') && !local.has_connector('connector.machine_max.right_front_light')"
				},
				"LeftFrontHeadLight": {
					"scale": "!local.has_connector('connector.machine_max.left_front_light')"
				},
				"RightFrontHeadLight": {
					"scale": "!local.has_connector('connector.machine_max.right_front_light')"
				},
				"LeftFrontGlass": {
					"scale": "!local.subsystem_destroyed('subsystem.machine_max.glass')"
				},
				"RightFrontGlass": {
					"scale": "!local.subsystem_destroyed('subsystem.machine_max.glass')"
				},
				"BackGlass": {
					"scale": "!local.subsystem_destroyed('subsystem.machine_max.glass')"
				},
				"ysmGlowLeftFogLight": {
					"scale": "local.subsystem_active('subsystem.machine_max.left_fog_lamp')"
				},
				"ysmGlowRightFogLight": {
					"scale": "local.subsystem_active('subsystem.machine_max.right_fog_lamp')"
				},
				"RightDoorMirror": {
					"scale": "!local.subsystem_destroyed('subsystem.machine_max.rearview_mirror')"
				},
				"LeftDoorMirror": {
					"scale": "!local.subsystem_destroyed('subsystem.machine_max.rearview_mirror')"
				},
				"ysmGlowGtRightMain": {
					"scale": "local.subsystem_active('subsystem.machine_max.right_main_light')"
				},
				"ysmGlowGtLeftMain": {
					"scale": "local.subsystem_active('subsystem.machine_max.left_main_light')"
				},
				"ysmGlowGt1": {
					"scale": "local.subsystem_active('subsystem.machine_max.right_marker_light_01')"
				},
				"ysmGlowGt2": {
					"scale": "local.subsystem_active('subsystem.machine_max.right_marker_light_02')"
				},
				"ysmGlowGt3": {
					"scale": "local.subsystem_active('subsystem.machine_max.left_marker_light_02')"
				},
				"ysmGlowGt4": {
					"scale": "local.subsystem_active('subsystem.machine_max.left_marker_light_01')"
				},
				"ysmGlowGtLeftFog": {
					"scale": "local.subsystem_active('subsystem.machine_max.left_fog_light')"
				},
				"ysmGlowGtRightFog": {
					"scale": "local.subsystem_active('subsystem.machine_max.right_fog_light')"
				}
			}
		}
	}
}