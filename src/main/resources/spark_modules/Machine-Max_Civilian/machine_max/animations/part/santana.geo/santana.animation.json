{
	"format_version": "1.8.0",
	"animations": {
		"parallel0": {
			"loop": true,
			"bones": {
				"SteeringWheelSpin": {
					"rotation": [
						0,
						0,
						"-(local.connector_rotation('connector.machine_max.hull_left_front_wheel', 1) + local.connector_rotation('connector.machine_max.hull_right_front_wheel', 1))*2"
					]
				},
				"ThrottlePedal": {
					"rotation": ["15 * math.clamp(100 * math.abs(local.get('throttle')), 0, 1)", 0, 0]
				},
				"BrakePedal": {
					"rotation": ["12 * math.clamp(local.get('brake'), 0, 1)", 0, 0]
				},
				"ClutchPedal": {
