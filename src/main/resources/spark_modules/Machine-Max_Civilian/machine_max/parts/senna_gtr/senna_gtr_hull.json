{
  "$schema": "../../docs/zh_cn/schemas/part_definition_schema.json",
  "icon": "machine_max:textures/icon/senna_gtr/senna_gtr_hull_icon.png",
  "vehicle_durability_rate": 0.50,
  "vehicle_damage_rate": 1.00,
  "vehicle_damage_rate_destroyed": 0.10,
  "variants": {
    "front": {
      "model": "machine_max:senna_gtr_front_hull.geo",
      "textures": "machine_max:textures/part/senna_gtr/senna_gtr.png",
      "animations": "machine_max:senna_gtr",
      "tags": ["machine_max:type/land", "machine_max:category/structural", "machine_max:hull", "machine_max:direction/front", "machine_max:series/senna_gtr"],
      "sub_parts": {
        "sub_part.machine_max.main": {
          "durability": 75,
          "mass": 50.0,
          "block_collision": "ground",
          "collision_height": 2.5,
          "hit_boxes": {
            "Collision": {
              "id": "part",
              "type": "box",
              "material": "machine_max:7035_aluminum_alloy"
            }
          },
          "connectors": {
            "connector.machine_max.chassis_front": {
              "locator": "hull_chassis_front",
              "definition": "machine_max:fixed_down",
              "overwrite": { "integrity": 50.0, "impact_absorption": 0.25, "impact_reduction": 5.0 }
            },
            "connector.machine_max.left_door_axis": {
              "locator": "hull_left_door_axis",
              "definition": "machine_max:senna_gtr_left_door_axis"
            },
            "connector.machine_max.right_door_axis": {
              "locator": "hull_right_door_axis",
              "definition": "machine_max:senna_gtr_right_door_axis"
            }
          },
          "subsystems": {
            "subsystem.machine_max.left_front_door_driver": {
              "type": "machine_max:joint_driver",
              // 闭位弹簧力矩 1200 N·m，普通型号的 250 N·m 压不到底
              "definition": "machine_max:rotation_joint_driver_heavy",
              "connector": "connector.machine_max.left_door_axis"
            },
            "subsystem.machine_max.right_front_door_driver": {
              "type": "machine_max:joint_driver",
              "definition": "machine_max:rotation_joint_driver_heavy",
              "connector": "connector.machine_max.right_door_axis"
            }
          },
          "projected_area": [4.6, 6.9, 5.5],
          "hydro_priority": 10,
          "hydrodynamics": {
            "": {
              "front_drag": [0.1, 0.1],
              "back_drag": [0.1, 0.0]
            }
          }
        }
      }
    },
    "back": {
      "model": "machine_max:senna_gtr_back_hull.geo",
      "textures": "machine_max:textures/part/senna_gtr/senna_gtr.png",
      "animations": "machine_max:senna_gtr",
      "tags": ["machine_max:type/land", "machine_max:category/structural", "machine_max:hull", "machine_max:direction/back", "machine_max:series/senna_gtr"],
      "sub_parts": {
        "sub_part.machine_max.main": {
          "durability": 75,
          "mass": 50.0,
          "block_collision": "ground",
          "collision_height": 2.5,
          "hit_boxes": {
            "Collision": {
              "id": "part",
              "type": "box",
              "material": "machine_max:7035_aluminum_alloy"
            }
          },
          "connectors": {
            "connector.machine_max.chassis_back": {
              "locator": "hull_chassis_back",
              "definition": "machine_max:fixed_down",
              "overwrite": { "integrity": 50.0, "impact_absorption": 0.25, "impact_reduction": 5.0 }
            },
            "connector.machine_max.left_door_lock": {
              "locator": "hull_left_door_lock",
              "definition": "machine_max:fixed_rigid",
              "signal_targets": {
                "interact": [
                  "subsystem.machine_max.left_front_door_coupler"
                ]
              },
              "signal_translations": {
                "interact_left_front_door": "interact"
              },
              "overwrite": {
                // 锁扣：几发小口径即脱锁。铰链不带这组值，仍按 15 / 2.0 / 0.30 结算（见 5.14）
                "integrity": 3.5,
                "impact_reduction": 0.5,
                "impact_absorption": 0.6,
                "direction": "yp",
                "required_tags": [
                  "machine_max:door",
                  "machine_max:direction/left",
                  "machine_max:series/senna_gtr"
                ]
              }
            },
            "connector.machine_max.right_door_lock": {
              "locator": "hull_right_door_lock",
              "definition": "machine_max:fixed_rigid",
              "signal_targets": {
                "interact": [
                  "subsystem.machine_max.right_front_door_coupler"
                ]
              },
              "signal_translations": {
                "interact_right_front_door": "interact"
              },
              "overwrite": {
                // 锁扣：几发小口径即脱锁。铰链不带这组值，仍按 15 / 2.0 / 0.30 结算（见 5.14）
                "integrity": 3.5,
                "impact_reduction": 0.5,
                "impact_absorption": 0.6,
                "direction": "yp",
                "required_tags": [
                  "machine_max:door",
                  "machine_max:direction/right",
                  "machine_max:series/senna_gtr"
                ]
              }
            }
          },
          "subsystems": {
            "subsystem.machine_max.left_front_door_coupler": {
              "type": "machine_max:coupler",
              "definition": "machine_max:door_latch",
              "connector": "connector.machine_max.left_door_lock",
              // 扣合状态发到装配体的信号存储：左前快速上座区在底盘零件上，跨零件只能按频道名读
              "state_outputs": {
                "senna_left_door_latched": ["global"]
              }
            },
            "subsystem.machine_max.right_front_door_coupler": {
              "type": "machine_max:coupler",
              "definition": "machine_max:door_latch",
              "connector": "connector.machine_max.right_door_lock",
              "state_outputs": {
                "senna_right_door_latched": ["global"]
              }
            }
          },
          "projected_area": [4.6, 6.9, 5.5],
          "hydro_priority": 10,
          "hydrodynamics": {
            "": {
              "front_drag": [0.1, 0.05],
              "back_drag": [0.1, 0.1],
              "y_lift": -0.001
            }
          }
        }
      }
    }
  }
}