{
  "$schema": "../../docs/zh_cn/schemas/part_definition_schema.json",
  "icon": "machine_max:textures/icon/senna_gtr/senna_gtr_door_icon.png",
  "vehicle_durability_rate": 0.02,
  "vehicle_damage_rate": 0.05,
  "vehicle_damage_rate_destroyed": 0.00,
  "max_stack_size": 2,
  "variants": {
    "left": {
      "model": "machine_max:senna_gtr_door_left.geo",
      "textures": "machine_max:textures/part/senna_gtr/senna_gtr.png",
      "animations": "machine_max:empty",
      "tags": ["machine_max:type/land", "machine_max:category/structural", "machine_max:door", "machine_max:direction/left", "machine_max:series/senna_gtr"],
      "sub_parts": {
        "sub_part.machine_max.main": {
          "durability": 50.0,
          "mass": 35.0,
          "block_collision": "ground",
          "collision_height": 2.5,
          "hit_boxes": {
            "Collision": {
              "type": "box",
              "material": "machine_max:7035_aluminum_alloy"
            }
          },
          "interact_boxes": {
            "interact.machine_max.left_front_door": {
              "bone": "interact_left_front_door",
              "condition": "local.has_connector('connector.machine_max.axis')", // 未装上车体（铰链没有对端）的件不提示
              "interact_mode": "accurate",
              "signal_targets": {
                "interact_left_front_door": [
                  "connector.machine_max.lock",
                  "global"
                ]
              }
            }
          },
          "connectors": {
            "connector.machine_max.axis": {
              "locator": "left_door_hull_axis",
              "definition": "machine_max:fixed_down"
            },
            "connector.machine_max.lock": {
              "locator": "left_door_hull_lock",
              "definition": "machine_max:fixed_down",
              "overwrite": {
                // 锁扣：几发小口径即脱锁。铰链不带这组值，仍按 15 / 2.0 / 0.30 结算（见 5.14）
                "integrity": 3.5,
                "impact_reduction": 0.5,
                "impact_absorption": 0.6,
                "required_tags": [
                  "machine_max:hull",
                  "machine_max:series/senna_gtr"
                ]
              }
            }
          },
          "projected_area": [0.19, 1.04, 0.29],
          "hydrodynamics": {
            "": {
              "front_drag": [0.1, 0.1],
              "back_drag": [0.1, 0.1]
            }
          }
        }
      }
    },
    "right": {
      "model": "machine_max:senna_gtr_door_right.geo",
      "textures": "machine_max:textures/part/senna_gtr/senna_gtr.png",
      "animations": "machine_max:empty",
      "tags": ["machine_max:type/land", "machine_max:category/structural", "machine_max:door", "machine_max:direction/right", "machine_max:series/senna_gtr"],
      "sub_parts": {
        "sub_part.machine_max.main": {
          "durability": 50.0,
          "mass": 35.0,
          "block_collision": "ground",
          "collision_height": 2.5,
          "hit_boxes": {
            "Collision": {
              "type": "box",
              "material": "machine_max:7035_aluminum_alloy"
            }
          },
          "interact_boxes": {
            "interact.machine_max.right_front_door": {
              "bone": "interact_right_front_door",
              "condition": "local.has_connector('connector.machine_max.axis')", // 未装上车体（铰链没有对端）的件不提示
              "interact_mode": "accurate",
              "signal_targets": {
                "interact_right_front_door": [
                  "connector.machine_max.lock",
                  "global"
                ]
              }
            }
          },
          "connectors": {
            "connector.machine_max.axis": {
              "locator": "right_door_hull_axis",
              "definition": "machine_max:fixed_down"
            },
            "connector.machine_max.lock": {
              "locator": "right_door_hull_lock",
              "definition": "machine_max:fixed_down",
              "overwrite": {
                // 锁扣：几发小口径即脱锁。铰链不带这组值，仍按 15 / 2.0 / 0.30 结算（见 5.14）
                "integrity": 3.5,
                "impact_reduction": 0.5,
                "impact_absorption": 0.6,
                "required_tags": [
                  "machine_max:hull",
                  "machine_max:series/senna_gtr"
                ]
              }
            }
          },
          "projected_area": [0.19, 1.04, 0.29],
          "hydrodynamics": {
            "": {
              "front_drag": [0.1, 0.1],
              "back_drag": [0.1, 0.1]
            }
          }
        }
      }
    }
  }
}