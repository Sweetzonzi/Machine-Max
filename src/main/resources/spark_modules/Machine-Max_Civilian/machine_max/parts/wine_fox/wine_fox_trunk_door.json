{
  "$schema": "../../docs/zh_cn/schemas/part_definition_schema.json",
  "icon": "machine_max:textures/icon/wine_fox/wine_fox_trunk_door_icon.png",//(可选, 留空会使用紫黑格子)部件图标路径
  "vehicle_durability_rate": 0.02,//(可选, 默认1.0)载具耐久贡献系数, 部件耐久度按此比例贡献给载具总耐久度
  "vehicle_damage_rate": 0.05,//(可选, 默认1.0)常态载具伤害传导系数, 部件受到伤害时按此比例传导给载具
  "vehicle_damage_rate_destroyed": 0.00,//(可选, 默认0.5)部件被摧毁后的载具伤害传导系数, 部件被摧毁后受到伤害时按此比例传导给载具
  "variants": {//部件变体列表, 支持单值或多键值对
    "model": "machine_max:wine_fox.geo", //模型路径
    "textures": {
      "default": "machine_max:textures/part/wine_fox/wine_fox_2.png",
      "old": "machine_max:textures/part/wine_fox/wine_fox.png"
    },
    "animations": "machine_max:wine_fox",
    "tags": ["machine_max:type/land", "machine_max:category/structural", "machine_max:trunk", "machine_max:series/wine_fox"], //(可选)部件标签列表
    "sub_parts": {//零件(子部件)列表
      "sub_part.machine_max.main": {//零件(子部件)名称
        "start_bone": "Trunk", // (可选，默认空)起始骨骼名称，此骨骼及其包含的骨骼才会被作为零件的渲染与定义用模型
        "durability": 30,//(可选, 默认20.0)部件基础生命值, 降至0时部件的所有子系统会瘫痪
        "mass": 10.0,//零件质量(kg)
        "block_collision": "ground",//(可选, 默认true)地形碰撞模式:true(与所有方块碰撞),ground(仅与低于部件最低位置的地面方块碰撞),false(不与任何方块碰撞)
        "collision_height": 2.5,//(可选)碰撞检测高度(m), 遭遇的障碍小于此高度时不与障碍发生碰撞(方块碰撞模式需要为ground), 默认所有障碍均碰撞
        "hit_boxes": {//键:骨骼名称, 会寻找名称匹配的骨骼, 并根据其中的方块创建不同形状的碰撞体, 以及将此骨骼下的定位器储存起来供子系统等使用
          "TrunkHitBox": {//骨骼名称, 会寻找名称匹配的骨骼, 并根据其中的方块创建不同形状的碰撞体
            "type": "box",//碰撞形状类型, 支持box、sphere、cylinder、wheel
            "material": "machine_max:structural_steel"
          },
          "BackGlass": { // 挡风玻璃
            "id": "glass",
            "type": "box",
            "thickness": 1,
            "material": "machine_max:glass",
            "subsystem": "subsystem.machine_max.glass",
            "condition": "!local.subsystem_destroyed('subsystem.machine_max.glass')" // 仅当前挡风玻璃未被摧毁时才生效
          },
          "TrunkLeftLight": {
            "type": "box",
            "thickness": 1,
            "material": "machine_max:glass",
            "subsystem": "subsystem.machine_max.left_tail_light",
            "condition": "!local.subsystem_destroyed('subsystem.machine_max.left_tail_light')"
          },
          "TrunkRightLight": {
            "type": "box",
            "thickness": 1,
            "material": "machine_max:glass",
            "subsystem": "subsystem.machine_max.right_tail_light",
            "condition": "!local.subsystem_destroyed('subsystem.machine_max.right_tail_light')"
          }
        },
        "interact_boxes": {//交互判定区列表
          "interact.machine_max.trunk_door": {//键:交互判定区名称
            "bone": "interact_trunk_door",//骨骼名称, 以其内部方块的位置与姿态作为交互判定区体积的位置和姿态
            "condition": "local.has_connector('connector.machine_max.axis')", // 未装上车体（铰链没有对端）的件不提示
            "interact_mode": "accurate",//(可选, 默认fast)精确交互: 玩家瞄准交互区按下交互键才触发
            "signal_targets": {//交互频道及目标: 铰链端口把同一次点击送去解扣, global 让车体状态机切动画
              // 开合事件沿门轴到车体状态机；解扣请求沿锁扣到车体锁扣子系统
              "interact": [
                "connector.machine_max.axis",
                "connector.machine_max.lock"
              ]
            }
          }
        },
        "subsystems": {
          "subsystem.machine_max.glass": {
            "type": "machine_max:basic", //无功能子系统, 仅用于表示玻璃是否被摧毁
            "definition": "machine_max:default_glass"
          },
          "subsystem.machine_max.left_tail_light": {
            "type": "machine_max:light",
            "definition": "machine_max:dummy_light"
          },
          "subsystem.machine_max.right_tail_light": {
            "type": "machine_max:light",
            "definition": "machine_max:dummy_light"
          }
        },
        "connectors": {//子部件用于与其他零件连接的连接点列表
          "connector.machine_max.axis": {//连接点名称
            "locator": "trunk_door_hull_axis",//Locator名称, 会寻找名称匹配的Locator, 以其位置与姿态作为连接点的位置和姿态
            "definition": "machine_max:fixed_down"
          },
          "connector.machine_max.lock": {//连接点名称
            "locator": "trunk_door_hull_lock",//Locator名称, 会寻找名称匹配的Locator, 以其位置与姿态作为连接点的位置和姿态
            "definition": "machine_max:fixed_down",//件侧锁扣保持 fixed_down（法线 yn），车体侧取 yp 与之配对
            "overwrite": {//两侧都弱化: 打盖板与打车体都能让锁扣先于铰链脱开
              // 锁扣：几发小口径即脱锁。铰链不带这组值，仍按 15 / 2.0 / 0.30 结算（见 5.14）
              "integrity": 3.5,
              "impact_reduction": 0.5,
              "impact_absorption": 0.6,
              "required_tags": ["machine_max:hull", "machine_max:series/wine_fox"]
            }
          }
        },
        "projected_area": [0.23, 0.35, 2.34],
        "hydrodynamics": {
          "": {
            "effective_range": 5,
            "front_drag": [0.0, 0.3],
            "back_drag": [0.0, 0.3]
          }
        }
      }
    }
  }
}