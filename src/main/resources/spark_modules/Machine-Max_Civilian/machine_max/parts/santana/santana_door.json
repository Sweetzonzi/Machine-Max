  "variants": {
    "left_front": {
      "model": "machine_max:santana.geo",
      "textures": "machine_max:textures/part/santana/santana.png",
      "tags": [
        "machine_max:type/land",
        "machine_max:category/structural",
        "machine_max:door",
        "machine_max:direction/left",
        "machine_max:position/front",
        "machine_max:series/santana"
      ],
      "sub_parts": {
        "sub_part.machine_max.main": {
          "start_bone": "AllLeftFrontDoor",
          "end_bones": [],
          "durability": 30,
          "mass": 24,
          "projected_area": [
            -1,
            -1,
            -1
          ],
          "hit_boxes": {
            "LeftFrontDoorCollision": {
              "type": "box",
              "material": "machine_max:structural_steel"
            }
          },
          "interact_boxes": {
            "interact.machine_max.left_front_door": {
              "bone": "LeftFrontDoorInteract",
              "interact_mode": "accurate",
              "signal_targets": {
                // 开合事件沿门轴到车体状态机；解扣请求沿锁扣到车体锁扣子系统
                "interact": [
                  "connector.machine_max.axis",
                  "connector.machine_max.lock"
                ]
              }
            }
          },
          "connectors": {
            "connector.machine_max.axis": {
              "locator": "door_lf_hinge",
              "definition": "machine_max:fixed_down"
            },
            "connector.machine_max.lock": {
              "locator": "door_lf_latch",
              "definition": "machine_max:fixed_left",
              "overwrite": {
                // 锁扣：几发小口径即脱锁。铰链不带这组值，仍按 15 / 2.0 / 0.30 结算（见 5.14）
                "integrity": 3.5,
                "impact_reduction": 0.5,
                "impact_absorption": 0.6,
                "required_tags": [
                  "machine_max:hull",
                  "machine_max:series/santana"
                ]
              }
            }
          },
          "hydrodynamics": {
            "": {
              "front_drag": [
                0,
                0
              ],
