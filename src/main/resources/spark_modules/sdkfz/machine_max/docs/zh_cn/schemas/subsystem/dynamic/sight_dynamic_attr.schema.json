{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://machine_max.io/schemas/subsystem/dynamic/sight_dynamic_attr.json",
  "title": "瞄准镜子系统动态属性",
  "description": "瞄准镜动态属性，定义挂载位置。信号路由由控制组统一处理。",
  "properties": {
    "type": {
      "type": "string",
      "const": "machine_max:sight",
      "description": "子系统类型，必须为 'machine_max:sight'。"
    },
    "definition": {
      "type": "string",
      "description": "子系统型号的资源地址，指向对应的子系统静态属性定义文件。"
    },
    "locator": {
      "type": "string",
      "default": "",
      "description": "瞄准镜挂载定位器名称，模型中的骨骼作为瞄准镜位置。"
    }
  },
  "required": ["type", "definition"],
  "examples": [
    {
      "type": "machine_max:sight",
      "definition": "machine_max:sight/tank_gunners_sight",
      "locator": "gunner_sight"
    }
  ]
}