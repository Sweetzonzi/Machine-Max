    {
      "ingredient": {
        "item": "machine_max:weapon_component_1"
      },
      "count": 3 // 武器部件：火炮、机枪与发射器
    },
    {
      "ingredient": {
        "item": "machine_max:mechanic_component_1"
      },
      "count": 3 // 机械零件：方位/俯仰随动与装填机构
    },
    {
      "ingredient": {
        "item": "machine_max:electronic_component_1"
      },
      "count": 4 // 电子元件：观瞄、席位与控制单元
    },
    {
      "ingredient": {
        "item": "machine_max:structural_component_1"
      },
      "count": 4 // 结构件：装甲与车体结构，按体量摊
    },
    {
      "ingredient": {
        "item": "minecraft:glass_pane"
      },
      "count": 1 // 玻璃板：观察窗与潜望镜，表尾最先被击碎
    }
  ],
  // 1.2 t 敞顶炮塔：50mm 火炮与 MG34 计 3 份武器件，防盾与座圈只占 4 份结构件
  "result": {
    "count": 1
  },
  "time": 220
}
