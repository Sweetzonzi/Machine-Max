{
  "$schema": "../docs/zh_cn/schemas/part_definition_schema.json",
  "icon": "conflict:textures/icon/stryker/stryker_backhatch.png",
  "vehicle_durability_rate": 0.6,
  "vehicle_damage_rate": 1.0,
  "vehicle_damage_rate_destroyed": 0.1,
  "variants": {
    "model": "conflict:stryker_all_base.geo",
    "textures": "conflict:textures/part/stryker_base/stryker_all_base.png",
    "tags": ["conflict:stryker_backhatch"],
    "sub_parts": {
      "sub_part.machine_max.main": {
        "start_bone": "Hatch_Hull_BackHatch",
        "end_bones": [],
        "durability": 120.0,
        "mass": 930.0,
        "block_collision": "ground",
        "collision_height": 1.5,
        "hit_boxes": {
          "BackHatchCollision": {
            "id": "part",
            "type": "box",
            "material": "machine_max:7035_aluminum_alloy",
            "thickness": 3
          }
        },
        "interact_boxes": {//交互判定区列表
          "interact.machine_max.interact_right_door": {//键:交互判定区名称
            "bone": "BackHatchInteract", //骨骼名称, 会寻找名称匹配的骨骼, 以其内部方块的位置与姿态作为交互判定区体积的位置和姿态
            "signal_targets": {
              "interact_hatch": ["vehicle"]//将交互信号转发给驾驶座
            },
            "interact_mode": "fast"//(可选, 默认fast)交互模式, fast为玩家碰撞箱与交互区碰撞时按下交互键触发, accurate为玩家瞄准交互区按下交互键触发
          }
        },
      "connectors": { //子部件用于与其他零件连接的连接点列表
        "connector.machine_max.left_hatch_axis": { //连接点名称
          "locator": "stryker_hatch_hull_left", //Locator名称, 会寻找名称匹配的Locator, 以其位置与姿态作为连接点的位置和姿态
          "definition": "machine_max:fixed_left"
        },
        "connector.machine_max.lock_hatch_axis": { //连接点名称
          "locator": "stryker_hatch_hull_lock", //Locator名称, 会寻找名称匹配的Locator, 以其位置与姿态作为连接点的位置和姿态
          "definition": "machine_max:fixed_left"
        },
        "connector.machine_max.right_hatch_axis": { //连接点名称
          "locator": "stryker_hatch_hull_right", //Locator名称, 会寻找名称匹配的Locator, 以其位置与姿态作为连接点的位置和姿态
          "definition": "machine_max:fixed_left"
        }
      },
        "subsystems": {
          "subsystem.machine_max.glow_left_main_light": {
            "type": "machine_max:basic", //无功能子系统, 仅用于表示是否被摧毁
            "definition": "machine_max:default_glass"
          },
          "subsystem.machine_max.glow_right_main_light": {
            "type": "machine_max:basic", //无功能子系统, 仅用于表示是否被摧毁
            "definition": "machine_max:default_glass"
          }
      }
    }
  }
}
}