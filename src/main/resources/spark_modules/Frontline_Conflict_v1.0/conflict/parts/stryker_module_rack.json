{
  "icon": "conflict:textures/icon/stryker/stryker_module_rack.png",
  "variants": {
    "left": {
      "model": "conflict:stryker_all_base.geo",
      "textures": "conflict:textures/part/stryker_base/stryker_all_base.png",
      "tags": [
        "machine_max:land",
        "conflict:stryker_module_rack"
      ],
      "sub_parts": {
        "sub_part.machine_max.main": {
          "start_bone": "LeftRack",
          "end_bones": [],
          "block_collision": "false",
          "collision_height": 2,
          "climb_assist": true,
          "hit_boxes": {
            "LeftRackCollision": {
              "id": "part",
              "type": "wheel",
              "material": "machine_max:off_road_tire",
              "thickness": 10
            }
          },
          "interact_boxes": { //交互判定区列表
            "interact.machine_max.left_rack": { //键:交互判定区名称
              "bone": "LeftRackInteract", //骨骼名称, 会寻找名称匹配的骨骼, 以其内部方块的位置与姿态作为交互判定区体积的位置和姿态
              "signal_targets": {
                "left_rack_interact": ["subsystem.machine_max.left_rack_box"] //将交互信号转发给驾驶座
              },
            "interact_mode": "accurate" //(可选, 默认fast)交互模式, fast为玩家碰撞箱与交互区碰撞时按下交互键触发, accurate为玩家瞄准交互区按下交互键触发
            }
          },
          "connectors": {
            "connector.machine_max.left_rack_hull": {
              "locator": "stryker_rack_left_hull",
              "definition": "machine_max:fixed_right",
              "overwrite": {}
            }
          },
          "subsystem": {
            "subsystem.machine_max.left_rack_box": {
              "type": "machine_max:item_storage", //储物子系统, 互动可打开存储容器
              "definition": "machine_max:default_trunk" //子系统型号, 需要与子系统类型相匹配
            }
          }
        }
      }
    },
    "right": {
      "model": "conflict:stryker_all_base.geo",
      "textures": "conflict:textures/part/stryker_base/stryker_all_base.png",
      "tags": [
        "machine_max:land",
        "conflict:stryker_module_rack"
      ],
      "sub_parts": {
        "sub_part.machine_max.main": {
          "start_bone": "RightRack",
          "end_bones": [],
          "block_collision": "false",
          "collision_height": 2,
          "climb_assist": true,
          "hit_boxes": {
            "RightRackCollision": {
              "id": "part",
              "type": "wheel",
              "material": "machine_max:off_road_tire",
              "thickness": 10
            }
          },
          "interact_boxes": { //交互判定区列表
            "interact.machine_max.right_Rack": { //键:交互判定区名称
              "bone": "RightRackInteract", //骨骼名称, 会寻找名称匹配的骨骼, 以其内部方块的位置与姿态作为交互判定区体积的位置和姿态
              "signal_targets": {
                "left_rack_interact": ["subsystem.machine_max.right_rack_box"] //将交互信号转发给驾驶座
              },
            "interact_mode": "accurate" //(可选, 默认fast)交互模式, fast为玩家碰撞箱与交互区碰撞时按下交互键触发, accurate为玩家瞄准交互区按下交互键触发
            }
          },
          "connectors": {
            "connector.machine_max.right_right_hull": {
              "locator": "stryker_rack_right_hull",
              "definition": "machine_max:fixed_left",
              "overwrite": {}
            }
          },
          "subsystem": {
            "subsystem.machine_max.right_rack_box": {
              "type": "machine_max:item_storage", //储物子系统, 互动可打开存储容器
              "definition": "machine_max:default_trunk" //子系统型号, 需要与子系统类型相匹配
            }
          }
        }
      }
    }
  },
  "$schema": "../docs/zh_cn/schemas/part_definition_schema.json"
