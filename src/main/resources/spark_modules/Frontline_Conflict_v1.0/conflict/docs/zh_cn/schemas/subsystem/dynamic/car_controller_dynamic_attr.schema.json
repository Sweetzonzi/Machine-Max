{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://machine_max.io/schemas/subsystem/dynamic/car_controller_dynamic_attr.json",
  "title": "车辆控制器子系统动态属性",
  "description": "车辆控制器的动态属性，定义信号输出目标和控制关系。",
  "properties": {
    "type": {
      "type": "string",
      "const": "machine_max:car_controller",
      "description": "子系统类型，必须为'machine_max:car_controller'。"
    },
    "definition": {
      "type": "string",
      "description": "子系统型号的资源地址，指向对应的子系统静态属性定义文件。"
    },
    "engine_outputs": {
      "$ref": "../base/signal_targets.json",
      "description": "引擎控制信号输出频道及目标。"
    },
    "wheel_outputs": {
      "$ref": "../base/signal_targets.json",
      "description": "轮控制信号输出频道及目标。"
    },
    "gearbox_outputs": {
      "$ref": "../base/signal_targets.json",
      "description": "变速箱控制信号输出频道及目标。"
    },
    "speed_outputs": {
      "$ref": "../base/signal_targets.json",
      "default": { "vehicle_speed": ["subpart", "vehicle"] },
      "description": "移动速度信号输出频道及目标。可选，默认将移动速度(m/s)发至部件和载具的vehicle_speed频道。"
    },
    "throttle_outputs": {
      "$ref": "../base/signal_targets.json",
      "default": { "throttle": ["subpart", "vehicle"] },
      "description": "油门信号输出频道及目标。可选，默认将油门[0,1]发至部件和载具的throttle频道。"
    },
    "brake_outputs": {
      "$ref": "../base/signal_targets.json",
      "default": { "brake": ["subpart", "vehicle"] },
      "description": "制动信号输出频道及目标。可选，默认将制动程度[0,1]发至部件和载具的brake频道。"
    },
    "steering_outputs": {
      "$ref": "../base/signal_targets.json",
      "default": { "steering": ["subpart", "vehicle"] },
      "description": "转向角度信号输出频道及目标。可选，默认将转向程度[-1,1]发至部件和载具的steering频道。"
    },
    "handbrake_outputs": {
      "$ref": "../base/signal_targets.json",
      "default": { "handbrake": ["subpart", "vehicle"] },
      "description": "手刹器开关信号输出频道及目标。可选，默认将手刹程度[0,1]发至部件和载具的handbrake频道。"
    }
  },
  "required": ["type", "definition", "engine_outputs", "wheel_outputs", "gearbox_outputs"],
  "examples": [
    {
      "type": "machine_max:car_controller",
      "definition": "machine_max:ae86at_car_controller",
      "engine_outputs": { "engine_control": ["engine"] },
      "wheel_outputs": {
        "wheel_control": [
          "left_front_wheel_driver",
          "right_front_wheel_driver",
          "left_back_wheel_driver",
          "right_back_wheel_driver"
        ]
      },
      "gearbox_outputs": { "gearbox_control": ["gearbox"] }
    }
  ]
}