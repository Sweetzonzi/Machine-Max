{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "machine_max:armor_spall",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "machine_max:textures/particle/spark_atlas"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 28
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.8
      },
      "minecraft:emitter_shape_point": {
        "offset": [0, 0, 0],
        "direction": [
          "math.cos(variable.particle_random_3 * 360) * 0.18 * math.sqrt(variable.particle_random_2)",
          "math.sin(variable.particle_random_3 * 360) * 0.18 * math.sqrt(variable.particle_random_2)",
          "1"
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.28 + 0.27 * variable.particle_random_4"
      },
      "minecraft:particle_initial_speed": "9 + 13 * variable.particle_random_2",
      "minecraft:particle_initial_spin": {
        "rotation": "0"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [0, -4.4, 0],
        "linear_drag_coefficient": 2.2
      },
      "minecraft:particle_motion_collision": {
        "coefficient_of_restitution": 0.45,
        "collision_drag": 4,
        "collision_radius": 0.02
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.26 + 0.28 * variable.particle_random_3) * (1 - 0.45 * variable.particle_age / variable.particle_lifetime)",
          "0.064 + 0.036 * variable.particle_random_4"
        ],
        "facing_camera_mode": "lookat_direction",
        "uv": {
          "texture_width": 64,
          "texture_height": 16,
          "uv": [16, 0],
          "uv_size": [16, 16]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "variable.particle_age / variable.particle_lifetime",
          "gradient": {
            "0.0": "#FFFFF6C8",
            "0.3": "#FFFFD36B",
            "0.62": "#FFFF7A2A",
            "1.0": "#008A2418"
          }
        }
      },
      "minecraft:particle_appearance_lighting": {},
      "minecraft:emitter_lifetime_events": {
        // 发射器时钟走到 0 秒时触发一次 "hit"，把闪光与烟尘带出来。
        // 发射器级的 creation_event 在 Spark-Core 里尚未触发，时间线的 0.0 等价于"创建后首个 tick"。
        "timeline": {
          "0.0": "hit"
        }
      }
    },
    "events": {
      "hit": [
        {
          // 命中点的加色闪光：比火花更快、更短，负责"这一下很亮"
          "particle_effect": {
            "effect": "machine_max:metal_hit_flash",
            "type": "emitter"
          }
        },
        {
          // 金属烟尘：沿喷射轴散开的低透明度烟团，负责"打出了东西"
          "particle_effect": {
            "effect": "machine_max:metal_dust",
            "type": "emitter"
          }
        }
      ]
    }
  }
}
