{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "machine_max:armor_deflect",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "machine_max:textures/particle/spark_atlas"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 16
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.5
      },
      "minecraft:emitter_shape_point": {
        "offset": [0, 0, 0],
        "direction": [
          "math.cos(variable.particle_random_3 * 360) * 0.58 * math.sqrt(variable.particle_random_2)",
          "math.sin(variable.particle_random_3 * 360) * 0.58 * math.sqrt(variable.particle_random_2)",
          "1"
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.14 + 0.16 * variable.particle_random_4"
      },
      "minecraft:particle_initial_speed": "4 + 5 * variable.particle_random_2",
      "minecraft:particle_initial_spin": {
        "rotation": "0"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [0, -4.4, 0],
        "linear_drag_coefficient": 3.2
      },
      "minecraft:particle_motion_collision": {
        "coefficient_of_restitution": 0.3,
        "collision_drag": 5,
        "collision_radius": 0.02
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.09 + 0.10 * variable.particle_random_3) * (1 - 0.5 * variable.particle_age / variable.particle_lifetime)",
          "0.030 + 0.016 * variable.particle_random_4"
        ],
        "facing_camera_mode": "lookat_direction",
        "uv": {
          "texture_width": 64,
          "texture_height": 16,
          "uv": [32, 0],
          "uv_size": [16, 16]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "variable.particle_age / variable.particle_lifetime",
          "gradient": {
            "0.0": "#FFFFFFFF",
            "0.25": "#FFFFF0B0",
            "0.6": "#FFFFB04A",
            "1.0": "#007A2A1A"
          }
        }
      },
      "minecraft:particle_appearance_lighting": {}
    }
  }
}
