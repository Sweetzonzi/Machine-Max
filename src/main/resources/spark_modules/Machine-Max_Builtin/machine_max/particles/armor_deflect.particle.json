{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "machine_max:armor_deflect",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "machine_max:textures/particle/spark_atlas"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 16
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.5
      },
      "minecraft:emitter_shape_point": {
        "offset": [0, 0, 0],
        "direction": [
          "math.cos(variable.particle_random_3 * 360) * 0.58 * math.sqrt(variable.particle_random_2)",
          "math.sin(variable.particle_random_3 * 360) * 0.58 * math.sqrt(variable.particle_random_2)",
          "1"
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.14 + 0.16 * variable.particle_random_4"
      },
      "minecraft:particle_initial_speed": "4 + 5 * variable.particle_random_2",
      "minecraft:particle_initial_spin": {
        "rotation": "0"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [0, -4.4, 0],
        "linear_drag_coefficient": 3.2
      },
      "minecraft:particle_motion_collision": {
        "coefficient_of_restitution": 0.3,
        "collision_drag": 5,
        "collision_radius": 0.02
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.18 + 0.20 * variable.particle_random_3) * (1 - 0.5 * variable.particle_age / variable.particle_lifetime)",
          "0.060 + 0.032 * variable.particle_random_4"
        ],
        "facing_camera_mode": "lookat_direction",
        "uv": {
          "texture_width": 64,
          "texture_height": 16,
          "uv": [32, 0],
          "uv_size": [16, 16]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "variable.particle_age / variable.particle_lifetime",
          "gradient": {
            "0.0": "#FFFFFFFF",
            "0.25": "#FFFFF0B0",
            "0.6": "#FFFFB04A",
            "1.0": "#007A2A1A"
          }
        }
      },
      "minecraft:particle_appearance_lighting": {},
      "minecraft:emitter_lifetime_events": {
        // 发射器时钟走到 0 秒时触发一次 "hit"，把闪光与烟尘带出来。
        // 发射器级的 creation_event 在 Spark-Core 里尚未触发，时间线的 0.0 等价于"创建后首个 tick"。
        "timeline": {
          "0.0": "hit"
        }
      }
    },
    "events": {
      "hit": [
        {
          // 命中点的加色闪光：弹开与击穿一样会亮一下
          "particle_effect": {
            "effect": "machine_max:metal_hit_flash",
            "type": "emitter"
          }
        },
        {
          // 金属烟尘：未击穿时也要有被砸出来的碎屑感
          "particle_effect": {
            "effect": "machine_max:metal_dust",
            "type": "emitter"
          }
        }
      ]
    }
  }
}
