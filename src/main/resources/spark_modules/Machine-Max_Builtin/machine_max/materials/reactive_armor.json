{
  "$schema": "../docs/zh_cn/schemas/base/material_attr.schema.json",
  "physics": {
    "friction": [
      0.35,
      0.35,
      0.35
    ],
    "slip_adaptation": 0.65,
    "rolling_friction": 0.28,
    "spinning_friction": 0.0,
    "restitution": 0.07,
    "block_damage_factor": 1.3
  },
  "armor": {
    "angle_effect": true, // (可选, 默认true)等效厚度随入射角变大
    "unpen_power": 0.0, // (可选, 默认0)未击穿不产生钝伤：砖的失效由子系统判定，不靠伤害
    "impact_modifiers": [ // 碰撞冲击的伤害乘算，与 machine_max:rha 同口径
      {
        "operation": "multiply",
        "value": 0.55,
        "condition": {
          "type": "always"
        }
      }
    ],
    "penetration_modifiers": [ // 加性：爆反削掉的是固定的穿透量，与来弹总穿深无关；按比例削弱会让强弹损失更多毫米，方向相反
      {
        "operation": "add",
        "value": -20,
        "condition": {
          "type": "always"
        }
      },
      {
        "operation": "add",
        "value": -230,
        "condition": { // 化学能（爆炸/射流）再吃一段：一段装药能截断的射流长度不随射流强弱成比例
          "type": "or",
          "conditions": [
            {
              "type": "damage_type",
              "id": "machine_max:blast"
            },
            {
              "type": "damage_tag",
              "id": "minecraft:is_explosion"
            }
          ]
        }
      }
    ],
    "damage_modifiers": [
      {
        "operation": "add",
        "value": -9.0,
        "condition": {
          "type": "damage_type",
          "id": "minecraft:fly_into_wall"
        }
      },
      {
        "operation": "multiply",
        "value": 0.09,
        "condition": {
          "type": "damage_type",
          "id": "minecraft:sweet_berry_bush"
        }
      },
      {
        "operation": "multiply",
        "value": 0.09,
        "condition": {
          "type": "entity_type",
          "id": "minecraft:slime"
        }
      }
    ],
    "rha": 1.0, // 相对轧制均质装甲的抗穿系数，与命中箱 thickness 相乘得到 mm 等效厚度
    "dmg_resist": 1.0,
    "dmg_mult": 0.95,
    "decay_rha": 1.0, // 与 rha 相同 → 系数恒为 1.0，等效厚度恒为 thickness，不随零件耐久下降；砖的失效由子系统与 condition 表达
    "decay_power": 1.5, // 只在 rha 与 decay_rha 不同时起作用
    "decay_dmg_resist": 0.0,
    "decay_dmg_mult": 1.0
  },
  "sounds": {
    "hit_un_pen": {
      "sound_id": "machine_max:hit_box.hit.up_pen.metal",
      "range": 64
    },
    "hit_pen": {
      "sound_id": "machine_max:hit_box.hit.pen.metal",
      "range": 64
    }
  },
  "particles": {
    "hit_pen": "machine_max:armor_spall", // 击穿时的命中火花：顺着弹道喷出的金属碎屑
    "hit_un_pen": "machine_max:armor_deflect" // 未击穿（含跳弹）时的命中火花：沿装甲表面弹开
  }
}
