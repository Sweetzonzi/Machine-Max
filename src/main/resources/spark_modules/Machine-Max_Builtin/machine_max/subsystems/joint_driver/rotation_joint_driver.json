{
  "$schema": "../../docs/zh_cn/schemas/subsystem/subsystem_static_attr.schema.json",
  "type": "machine_max:joint_driver",
  // 三个旋转轴全开：铰链上真正转动的轴由连接点限位决定，另外两轴的目标角恒为 0，
  // 被限位钳住后只起锁轴作用，所以同一型号可以直接挂在绕 X、Y、Z 轴开合的任一铰链上。
  // 力值取 250 N·m。桑塔纳两块盖板的弹簧刚度是 2.3 / 1.4 N·m/度（折算 131.8 / 80.2 N·m/rad），
  // 平衡位在开限位、开位的弹簧托力为 0；自重绕铰链的静力矩约 150 N·m，所以 250 N·m 里大部分用来托住
  // 或加速盖板的质量：起步有明显的加速段，力再大就变成刚性跟随、开合没有惯性。
  // 闭位静力矩超过 250 N·m 的铰链改用 machine_max:rotation_joint_driver_heavy。
  // 盖板要停在开度上得靠驱动器持续给目标角，所以盖板的开片段写 loop: true、关片段写单次（走完松手，由锁扣承力）。
  // 速度取 180 °/s：75° 的舱盖约 0.4 s 走完。
  "axes": {
    "XR": {
      "max_force": 250,
      "max_speed": 180
    },
    "YR": {
      "max_force": 250,
      "max_speed": 180
    },
    "ZR": {
      "max_force": 250,
      "max_speed": 180
    }
  }
}
