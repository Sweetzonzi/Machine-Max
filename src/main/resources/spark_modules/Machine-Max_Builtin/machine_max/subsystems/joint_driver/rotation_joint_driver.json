{
  "$schema": "../../docs/zh_cn/schemas/subsystem/subsystem_static_attr.schema.json",
  "type": "machine_max:joint_driver",
  // 三个旋转轴全开：铰链上真正转动的轴由连接点限位决定，另外两轴的目标角恒为 0，
  // 被限位钳住后只起锁轴作用，所以同一型号可以直接挂在绕 X、Y、Z 轴开合的任一铰链上。
  // 力值取 250 N·m。桑塔纳引擎盖自重绕铰链的力矩约 150 N·m，盖板铰链的弹簧平衡位置在全开处，
  // 关合位上弹簧只把盖板托开一道十度左右的缝，因此驱动器在行程里并不对抗大载荷，250 N·m 基本
  // 都用来给盖板的质量加速：起步有明显的加速段，力再大就变成刚性跟随、开合没有惯性。
  // 速度取 180 °/s：75° 的舱盖约 0.4 s 走完。
  "axes": {
    "XR": {
      "max_force": 250,
      "max_speed": 180
    },
    "YR": {
      "max_force": 250,
      "max_speed": 180
    },
    "ZR": {
      "max_force": 250,
      "max_speed": 180
    }
  }
}
