{
  "$schema": "../../docs/zh_cn/schemas/subsystem/subsystem_static_attr.schema.json",
  "type": "machine_max:engine",
  "basic_durability": 60,
  "pass_damage": false, //(可选, 默认true)是否将子系统受到的伤害传递给零件
  "max_power": 176500,
  "max_torque": 883,
  "idle_rpm": 500,
  "max_torque_rpm": 1500,
  "red_line_rpm": 2100,
  "red_line_torque_ratio": 0.909,
  "inertia": 10, // 曲轴+飞轮实车 1~3 kg·m²；30.96:1 的一挡下 50 会折成 437 t 等效质量
  "cylinder": 8,
  "sounds": {
    "fmod": {
      "bank": "machine_max:basic_vehicle_sounds",
      "drive": "event:/Default_Vehicles/Engine/Tanks/tank_drive_uni",
      "start": "event:/Default_Vehicles/Engine/Tanks/tank_start_uni",
      "stop": "event:/Default_Vehicles/Engine/Tanks/tank_stop_uni"
    }
  }
}
