{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://machine_max.io/schemas/subsystem/dynamic/weapon_controller_dynamic_attr.json",
  "title": "武器控制器子系统动态属性",
  "description": "武器控制器子系统的动态属性，定义控制信号输出频道等运行时配置。",
  "properties": {
    "type": {
      "type": "string",
      "const": "machine_max:weapon_controller",
      "description": "子系统类型，必须为'machine_max:weapon_controller'。"
    },
    "definition": {
      "type": "string",
      "description": "子系统型号的资源地址，指向对应的子系统静态属性定义文件。"
    },
    "control_outputs": {
      "allOf": [
        {
          "$ref": "../base/signal_targets.json"
        }
      ],
      "default": {},
      "description": "控制信号输出频道及目标列表。武器控制器通过这些频道向炮塔驱动和发射器发送控制信号，同时用于握手发现并绑定同载具内的下属子系统。"
    },
    "camera_discovery_targets": {
      "allOf": [
        {
          "$ref": "../base/signal_targets.json"
        }
      ],
      "default": {},
      "description": "本火控负责的视点发现表。同一 Part 内写子系统名（可跨子零件），跨 Part 写连接点名或 global；连接点与广播两条线路要求视点在自己的 discovery_inputs 里声明该频道。只读发现，不写信号槽，也不赋予对镜头的控制权。"
    },
    "first_hud_layout": {
      "allOf": [
        {
          "$ref": "../../base/resource_location.schema.json"
        }
      ],
      "default": "machine_max:empty",
      "description": "第一人称视角使用的 HUD 布局；machine_max:empty 表示该视角不显示 HUD。"
    },
    "third_hud_layout": {
      "allOf": [
        {
          "$ref": "../../base/resource_location.schema.json"
        }
      ],
      "default": "machine_max:empty",
      "description": "第三人称视角使用的 HUD 布局；machine_max:empty 表示该视角不显示 HUD。"
    },
    "scope_hud_layout": {
      "allOf": [
        {
          "$ref": "../../base/resource_location.schema.json"
        }
      ],
      "default": "machine_max:empty",
      "description": "炮镜视角使用的 HUD 布局；machine_max:empty 表示该视角不显示 HUD。"
    }
  },
  "required": [
    "type",
    "definition"
  ],
  "examples": [
    {
      "type": "machine_max:weapon_controller",
      "definition": "machine_max:basic_weapon_controller",
      "control_outputs": {
        "weapon_control": [
          "subsystem.machine_max.turret_base",
          "subsystem.machine_max.barrel_elevation",
          "subsystem.machine_max.main_launcher"
        ]
      },
      "first_hud_layout": "machine_max:weapon_live",
      "scope_hud_layout": "machine_max:weapon_live"
    }
  ]
}
