{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://machine_max.io/schemas/subsystem/static/regen_loader_static_attr.json",
  "title": "再生装弹机子系统静态属性",
  "description": "再生装弹机子系统的静态属性，定义弹仓容量、再生速率、每发能耗和弹药供给行为。",
  "properties": {
    "$schema": { "type": "string", "description": "JSON Schema 引用路径", "default": "../../docs/zh_cn/schemas/subsystem/subsystem_static_attr.schema.json" },
    "type": { "type": "string", "const": "machine_max:regen_loader", "description": "子系统类型，必须为 'machine_max:regen_loader'。" },
    "basic_durability": { "type": "number", "minimum": 0, "default": 20.0, "description": "子系统基础耐久度。" },
    "pass_damage": { "type": "boolean", "default": true, "description": "是否将伤害传递给子系统持有者。" },
    "limit_damage": { "type": "boolean", "default": false, "description": "是否限制伤害传递值不超过剩余耐久度。" },
    "hidden": { "type": "boolean", "default": false, "description": "是否在 HUD 中隐藏该子系统。" },
    "magazine_capacity": { "type": "integer", "minimum": 1, "description": "弹仓容量。" },
    "regen_per_minute": { "type": "number", "minimum": 0, "default": 0, "description": "每分钟再生数量。0 = 无自动再生。" },
    "regen_round_by_round": { "type": "boolean", "default": true, "description": "true = 随打随产，false = 批量产出。" },
    "energy_cost_per_round": { "type": "number", "minimum": 0, "default": 0, "description": "每发再生消耗的能量（焦耳）。0 = 免费。" },
    "projectile_type": { "$ref": "../../base/resource_location.schema.json", "description": "投射物类型资源路径。" },
    "reload_time": { "type": "number", "minimum": 0, "description": "输送一发弹药所需时间（秒）。" },
    "can_supply_multiple": { "type": "boolean", "default": false, "description": "是否允许多消费者并行接收弹药。" },
    "regen_delay": { "type": "number", "minimum": 0, "default": 0, "description": "输送弹药后的再生启动延迟（秒）。0 = 边产边供。" },
    "sounds": {
      "type": "object",
      "properties": {
        "on_destroyed": { "$ref": "../../base/sound_event.schema.json", "description": "摧毁音效。", "default": { "sound_id": "machine_max:empty_sound", "range": 16 } },
        "on_activate": { "$ref": "../../base/sound_event.schema.json", "description": "激活音效。", "default": { "sound_id": "machine_max:empty_sound", "range": 16 } }
      },
      "additionalProperties": false,
      "description": "音效配置。"
    }
  },
  "required": ["type", "magazine_capacity", "projectile_type", "reload_time"],
  "additionalProperties": false,
  "examples": [
    { "type": "machine_max:regen_loader", "magazine_capacity": 100, "projectile_type": "machine_max:some_projectile", "reload_time": 0, "description": "最简示例" },
    { "type": "machine_max:regen_loader", "magazine_capacity": 150, "regen_per_minute": 800, "projectile_type": "machine_max:7_92mm_smk", "reload_time": 0, "regen_delay": 0.5, "description": "带再生延迟示例" }
  ]
}
