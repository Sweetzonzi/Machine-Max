{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://machine_max.io/schemas/subpart/hydrodynamic_attr.schema.json",
  "title": "流体动力属性",
  "description": "定义部件在流体（空气、水）中的动力属性，包括阻力、升力等。用于模拟空气动力学和水动力学效果。",
  "type": "object",
  "properties": {
    "scale": {
      "type": "number",
      "minimum": 0,
      "default": 1.0,
      "description": "缩放系数，用于整体调整流体动力效果。"
    },
    "effective_range": {
      "$ref": "../../base/vector_3d.schema.json",
      "default": [1.0, 1.0, 1.0],
      "description": "三个方向上的有效计算范围，单位为m，当在对应轴运动方向上的此距离内检测到遮挡时将会降低部件的实际空气阻力系数，以模拟如车壳遮挡整流带来的减阻效果。"
    },
    "transonic_amplifier": {
      "type": "number",
      "minimum": 0,
      "default": 5.0,
      "description": "跨音速放大系数，用于模拟跨音速时的阻力变化。当速度接近音速时，阻力会急剧增加。"
    },
    "front_drag": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 2,
      "maxItems": 2,
      "default": [0.1, 1.0],
      "description": "前向阻力系数列表，通常包含两个值：[一阶系数, 二阶系数]。"
    },
    "back_drag": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 2,
      "maxItems": 2,
      "default": [0.1, 1.0],
      "description": "后向阻力系数列表。"
    },
    "left_drag": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 2,
      "maxItems": 2,
      "default": [0.1, 1.0],
      "description": "左向阻力系数列表。"
    },
    "right_drag": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 2,
      "maxItems": 2,
      "default": [0.1, 1.0],
      "description": "右向阻力系数列表。"
    },
    "up_drag": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 2,
      "maxItems": 2,
      "default": [0.1, 1.0],
      "description": "上向阻力系数列表。"
    },
    "down_drag": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 2,
      "maxItems": 2,
      "default": [0.1, 1.0],
      "description": "下向阻力系数列表。"
    },
    "x_lift": {
      "type": "array",
      "items": { "type": "number" },
      "default": [],
      "description": "X轴升力系数列表。通常为空，表示不产生X轴升力。"
    },
    "y_lift": {
      "type": "array",
      "items": { "type": "number" },
      "default": [],
      "description": "Y轴升力系数列表。通常为空，表示不产生Y轴升力。"
    },
    "z_lift": {
      "type": "array",
      "items": { "type": "number" },
      "default": [],
      "description": "Z轴升力系数列表。通常为空，表示不产生Z轴升力。"
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "scale": 1.0,
      "effective_range": [5.0, 5.0, 5.0],
      "transonic_amplifier": 5.0,
      "front_drag": [0.2, 1.5],
      "back_drag": [0.3, 1.8],
      "description": "典型的车辆空气动力学配置"
    }
  ]
}