{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://machine_max.io/schemas/subsystem/static/view_attr.json",
  "title": "视图属性",
  "description": "座椅子系统的视图属性，定义第一人称和第三人称摄像机设置。",
  "type": "object",
  "properties": {
    "enable_first_person": {
      "type": "boolean",
      "default": true,
      "description": "是否启用第一人称视角。"
    },
    "first_person_hud": {
      "type": "array",
      "items": { "$ref": "../../base/resource_location.schema.json" },
      "default": [],
      "description": "第一人称视角的HUD界面资源列表。"
    },
    "first_person_offset": {
      "type": "number",
      "default": 0.0,
      "description": "第一人称视角的高度偏移，单位米。"
    },
    "enable_third_person": {
      "type": "boolean",
      "default": true,
      "description": "是否启用第三人称视角。"
    },
    "third_person_hud": {
      "type": "array",
      "items": { "$ref": "../../base/resource_location.schema.json" },
      "default": [],
      "description": "第三人称视角的HUD界面资源列表。"
    },
    "third_person_offset": {
      "type": "number",
      "default": 0.75,
      "description": "第三人称视角的高度偏移，单位米。"
    },
    "follow_vehicle": {
      "type": "boolean",
      "default": true,
      "description": "摄像机是否跟随车辆运动。"
    },
    "focus_on_center": {
      "type": "boolean",
      "default": true,
      "description": "是否聚焦于车辆中心。"
    },
    "distance_scale": {
      "type": "number",
      "minimum": 0,
      "default": 1.1,
      "description": "摄像机距离缩放系数。"
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "enable_first_person": true,
      "first_person_hud": ["machine_max:hud/driver"],
      "first_person_offset": 0.3,
      "enable_third_person": true,
      "distance_scale": 1.2
    }
  ]
}