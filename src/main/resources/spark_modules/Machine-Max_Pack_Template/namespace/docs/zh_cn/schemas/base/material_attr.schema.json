{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://machine_max.io/schemas/base/material_attr.json",
  "title": "材料属性",
  "description": "定义材料的物理属性、装甲防护和命中音效，按 physics / armor / sounds 三组组织。",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema引用路径，用于编辑器智能提示和验证",
      "default": "../docs/zh_cn/schemas/base/material_attr.schema.json"
    },
    "physics": {
      "type": "object",
      "description": "物理属性：摩擦、滑移、弹性等物理模拟参数。",
      "properties": {
        "friction": {
          "$ref": "vector_3d.schema.json",
          "default": [0.5, 0.5, 0.5],
          "description": "摩擦系数向量，格式为[x, y, z]。x为侧向摩擦系数，y为前向摩擦系数，z无实际意义。"
        },
        "slip_adaptation": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "default": 0.5,
          "description": "滑移适应系数，用于调整在滑动时的摩擦行为。"
        },
        "slip_curve": {
          "type": "object",
          "description": "轮胎滑移摩擦曲线参数。",
          "properties": {
            "longitudinal": {
              "type": "object",
              "description": "纵向滑移率曲线参数。",
              "properties": {
                "peak_slip_ratio": { "type": "number", "minimum": 0.0, "default": 0.2, "description": "峰值滑移率（无量纲）。" },
                "base_scale": { "type": "number", "default": 1.0, "description": "滑移率为0时的摩擦缩放。" },
                "peak_scale": { "type": "number", "default": 1.4, "description": "峰值滑移率处的摩擦缩放。" },
                "kinetic_scale": { "type": "number", "default": 0.9, "description": "高滑移状态下（动摩擦段）的摩擦缩放。" }
              },
              "additionalProperties": false
            },
            "lateral": {
              "type": "object",
              "description": "侧向滑移角曲线参数（角度单位为度）。",
              "properties": {
                "peak_angle_deg": { "type": "number", "minimum": 0.0, "default": 12.0, "description": "峰值侧偏角（度）。" },
                "kinetic_angle_deg": { "type": "number", "minimum": 0.0, "default": 90.0, "description": "进入动摩擦平台的侧偏角（度）。" },
                "base_scale": { "type": "number", "default": 1.0, "description": "侧偏角为0度时的摩擦缩放。" },
                "peak_scale": { "type": "number", "default": 1.2, "description": "峰值侧偏角处的摩擦缩放。" },
                "kinetic_scale": { "type": "number", "default": 0.7, "description": "高侧偏角状态下（动摩擦段）的摩擦缩放。" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "rolling_friction": { "type": "number", "minimum": 0.0, "default": 0.2, "description": "滚动摩擦系数。" },
        "spinning_friction": { "type": "number", "minimum": 0.0, "default": 0.0, "description": "旋转摩擦系数。" },
        "restitution": { "type": "number", "minimum": 0.0, "maximum": 1.0, "default": 0.1, "description": "恢复系数（弹性），0为完全非弹性碰撞，1为完全弹性碰撞。" },
        "block_damage_factor": { "type": "number", "minimum": 0.0, "default": 1.0, "description": "方块破坏系数，0为无法破坏方块。" }
      },
      "additionalProperties": false
    },
    "armor": {
      "type": "object",
      "description": "装甲属性：抗穿、线性减伤、百分比减伤、耐久衰减参数及条件化伤害修正器。伤害管线：damage_modifiers → (dmg - dmg_resist) * dmg_mult。",
      "properties": {
        "rha": { "type": "number", "minimum": 0.0, "default": 1.0, "description": "材料相对轧制均质装甲(RHA)的抗穿能力系数。" },
        "angle_effect": { "type": "boolean", "default": true, "description": "等效护甲厚度是否受入射角度影响。" },
        "dmg_resist": { "type": "number", "minimum": 0.0, "default": 1.0, "description": "全局线性减伤值，最终伤害将被减去该值（受耐久衰减影响）。" },
        "dmg_mult": { "type": "number", "minimum": 0.0, "maximum": 1.0, "default": 0.95, "description": "全局伤害乘数，最终伤害将被乘以该值（受耐久衰减影响）。0.95=承受95%伤害。" },
        "decay_rha": { "type": "number", "minimum": 0.0, "default": 0.3, "description": "耐久归零时 RHA 系数的残余值。" },
        "decay_dmg_resist": { "type": "number", "minimum": 0.0, "default": 0.0, "description": "耐久归零时线性减伤的残余值，默认0.0表示完全归零。" },
        "decay_dmg_mult": { "type": "number", "minimum": 0.0, "maximum": 1.0, "default": 1.0, "description": "耐久归零时伤害乘数的残余值，默认1.0表示完全失效。" },
        "decay_power": { "type": "number", "minimum": 0.0, "default": 1.5, "description": "装甲退化曲线指数。>1时装甲前期退化慢、临近损坏时快速失效（脆性）；=1时为线性退化。" },
        "unpen_power": { "type": "number", "minimum": 0.0, "default": 0.0, "description": "攻击未能完全击穿护甲时的伤害指数。公式: 伤害*(穿深/等效护甲)^unpen_power。" },
        "impact_modifiers": {
          "$ref": "../part/subpart/hit_box/modifier/damage_modifier.schema.json",
          "description": "条件驱动的冲击修正器。"
        },
        "penetration_modifiers": {
          "$ref": "../part/subpart/hit_box/modifier/damage_modifier.schema.json",
          "description": "条件驱动的穿深修正器。"
        },
        "damage_modifiers": {
          "$ref": "../part/subpart/hit_box/modifier/damage_modifier.schema.json",
          "description": "条件驱动的伤害修正器（类型/实体特定调节）。"
        }
      },
      "additionalProperties": false
    },
    "sounds": {
      "type": "object",
      "properties": {
        "hit_un_pen": {
          "$ref": "sound_event.schema.json",
          "description": "碰撞箱被命中但未穿透时的音效事件。",
          "default": { "sound_id": "machine_max:hit_box.hit.up_pen.metal", "range": 64 }
        },
        "hit_pen": {
          "$ref": "sound_event.schema.json",
          "description": "碰撞箱被命中且穿透时的音效事件。",
          "default": { "sound_id": "machine_max:hit_box.hit.pen.metal", "range": 64 }
        }
      },
      "additionalProperties": false,
      "description": "材料命中音效配置。"
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "physics": { "friction": [0.5, 0.5, 0.5] },
      "armor": {
        "rha": 1.0,
        "dmg_resist": 1.0,
        "dmg_mult": 0.95
      },
      "sounds": {
        "hit_un_pen": { "sound_id": "machine_max:hit_box.hit.up_pen.metal", "range": 64 },
        "hit_pen": { "sound_id": "machine_max:hit_box.hit.pen.metal", "range": 64 }
      }
    }
  ]
}
