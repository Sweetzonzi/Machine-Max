{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://machine_max.io/schemas/subsystem/static/view_attr.json",
  "title": "View Attributes",
  "description": "View attributes of the seat subsystem, defining first-person and third-person camera settings.",
  "type": "object",
  "properties": {
    "enable_first_person": {
      "type": "boolean",
      "default": true,
      "description": "Whether to enable first-person view."
    },
    "first_person_hud": {
      "type": "array",
      "items": { "$ref": "../../base/resource_location.schema.json" },
      "default": [],
      "description": "List of HUD interface resources for first-person view."
    },
    "first_person_offset": {
      "type": "number",
      "default": 0.0,
      "description": "Height offset for first-person view, in meters."
    },
    "enable_third_person": {
      "type": "boolean",
      "default": true,
      "description": "Whether to enable third-person view."
    },
    "third_person_hud": {
      "type": "array",
      "items": { "$ref": "../../base/resource_location.schema.json" },
      "default": [],
      "description": "List of HUD interface resources for third-person view."
    },
    "third_person_offset": {
      "type": "number",
      "default": 0.75,
      "description": "Height offset for third-person view, in meters."
    },
    "follow_vehicle": {
      "type": "boolean",
      "default": true,
      "description": "Whether the camera follows the vehicle movement."
    },
    "focus_on_center": {
      "type": "boolean",
      "default": true,
      "description": "Whether to focus on the vehicle center."
    },
    "distance_scale": {
      "type": "number",
      "minimum": 0,
      "default": 1.1,
      "description": "Camera distance scaling factor."
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "enable_first_person": true,
      "first_person_hud": ["machine_max:hud/driver"],
      "first_person_offset": 0.3,
      "enable_third_person": true,
      "distance_scale": 1.2
    }
  ]
}