{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://machine_max.io/schemas/subsystem/subsystem_dynamic_attr.json",
  "title": "子系统动态属性",
  "description": "子系统动态属性的顶层架构，根据 type 字段分派到具体子系统动态属性架构。type 接受 21 个已开放的内置 machine_max 类型，或命名空间不是 machine_max 的扩展类型；joint_driver、scriptable、battery 三个类型仍在开发中、字段契约未定稿，尚未登记，因此既不能在这里选择，也不会被运行时接受。",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "anyOf": [
        {
          "enum": [
          "machine_max:basic",
          "machine_max:seat",
          "machine_max:item_storage",
          "machine_max:engine",
          "machine_max:motor",
          "machine_max:car_controller",
          "machine_max:motorbike_controller",
          "machine_max:track_controller",
          "machine_max:track_drive",
          "machine_max:gearbox",
          "machine_max:transmission",
          "machine_max:wheel_driver",
          "machine_max:turret_driver",
          "machine_max:lighting",
          "machine_max:launcher",
          "machine_max:ammo_loader",
          "machine_max:ammo_rack",
          "machine_max:weapon_controller",
          "machine_max:camera",
          "machine_max:sight",
          "machine_max:regen_ammo_rack"
          ],
          "description": "内置子系统类型，取值必须是上列 21 个之一。"
        },
        {
          "pattern": "^(?!machine_max:)[a-z0-9_.-]+:[a-z0-9/._-]+$",
          "description": "扩展模组登记的类型：命名空间不能是 machine_max，因此拼错的内置类型不会被本分支接受。运行时仍要求该类型已登记，编辑器接受只表示字段由下游 schema 约束。"
        }
      ],
      "description": "子系统类型，决定使用哪个具体的子系统架构。"
    }
  },
  "additionalProperties": true,
  "required": [
    "type"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "machine_max:basic"
          }
        }
      },
      "then": {
        "$ref": "dynamic/basic_dynamic_attr.schema.json"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "machine_max:seat"
          }
        }
      },
      "then": {
        "$ref": "dynamic/seat_dynamic_attr.schema.json"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "machine_max:item_storage"
          }
        }
      },
      "then": {
        "$ref": "dynamic/item_storage_dynamic_attr.schema.json"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "machine_max:engine"
          }
        }
      },
      "then": {
        "$ref": "dynamic/engine_dynamic_attr.schema.json"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "machine_max:motor"
          }
        }
      },
      "then": {
        "$ref": "dynamic/motor_dynamic_attr.schema.json"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "machine_max:car_controller"
          }
        }
      },
      "then": {
        "$ref": "dynamic/car_controller_dynamic_attr.schema.json"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "machine_max:motorbike_controller"
          }
        }
      },
      "then": {
        "$ref": "dynamic/motorbike_controller_dynamic_attr.schema.json"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "machine_max:track_controller"
          }
        }
      },
      "then": {
        "$ref": "dynamic/track_controller_dynamic_attr.schema.json"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "machine_max:track_drive"
          }
        }
      },
      "then": {
        "$ref": "dynamic/track_drive_dynamic_attr.schema.json"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "machine_max:gearbox"
          }
        }
      },
      "then": {
        "$ref": "dynamic/gearbox_dynamic_attr.schema.json"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "machine_max:transmission"
          }
        }
      },
      "then": {
        "$ref": "dynamic/transmission_dynamic_attr.schema.json"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "machine_max:wheel_driver"
          }
        }
      },
      "then": {
        "$ref": "dynamic/wheel_driver_dynamic_attr.schema.json"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "machine_max:turret_driver"
          }
        }
      },
      "then": {
        "$ref": "dynamic/turret_driver_dynamic_attr.schema.json"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "machine_max:lighting"
          }
        }
      },
      "then": {
        "$ref": "dynamic/lighting_dynamic_attr.schema.json"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "machine_max:launcher"
          }
        }
      },
      "then": {
        "$ref": "dynamic/launcher_dynamic_attr.schema.json"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "machine_max:ammo_loader"
          }
        }
      },
      "then": {
        "$ref": "dynamic/ammo_loader_dynamic_attr.schema.json"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "machine_max:ammo_rack"
          }
        }
      },
      "then": {
        "$ref": "dynamic/ammo_rack_dynamic_attr.schema.json"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "machine_max:weapon_controller"
          }
        }
      },
      "then": {
        "$ref": "dynamic/weapon_controller_dynamic_attr.schema.json"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "machine_max:camera"
          }
        }
      },
      "then": {
        "$ref": "dynamic/camera_dynamic_attr.schema.json"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "machine_max:sight"
          }
        }
      },
      "then": {
        "$ref": "dynamic/sight_dynamic_attr.schema.json"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "machine_max:regen_ammo_rack"
          }
        }
      },
      "then": {
        "$ref": "dynamic/regen_ammo_rack_dynamic_attr.schema.json"
      }
    }
  ],
  "examples": [
    {
      "type": "machine_max:car_controller",
      "definition": "machine_max:ae86at_car_controller",
      "control_outputs": {
        "car_control": [
          "subsystem.machine_max.engine",
          "subsystem.machine_max.left_front_wheel_driver",
          "subsystem.machine_max.right_front_wheel_driver",
          "subsystem.machine_max.left_back_wheel_driver",
          "subsystem.machine_max.right_back_wheel_driver",
          "subsystem.machine_max.gearbox"
        ]
      }
    },
    {
      "type": "machine_max:engine",
      "definition": "machine_max:ae86at_engine",
      "power_output": "gearbox"
    }
  ]
}
