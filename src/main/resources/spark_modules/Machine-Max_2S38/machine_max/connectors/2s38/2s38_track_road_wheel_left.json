{
  "$schema": "../../docs/zh_cn/schemas/part/subpart/connector/connector_static_attr.schema.json",
  "type": "Advanced", //2S38 负重轮安装座，带悬挂行程，并保留绕 X 轴的滚动自由度
  "direction": "xp", //连接点法线方向，指向左侧负重轮
  "integrity": 15.0, //内部连接点恒不可破坏，此值仅作为外部复用时的基线
  "impact_absorption": 0.30,
  "impact_reduction": 2.0,
  "impact_multiplier": 1.0,
  "joint_attrs": {
    "y": {
      "lower_limit": -0.16, //悬挂行程下限(m)，总行程 0.32 m
      "upper_limit": 0.16, //悬挂行程上限(m)
      "equilibrium": -0.1, //轮心相对车体的平衡位置下移，抬高车体并保留压缩余量
      "stiffness": 120000, //每轮簧上约 1.5 t，静挠度 0.12 m；通用负重轮的 50000 在这台车上会压到限位
      "damping": 7200 //ζ≈0.25；阻尼钳位要求成员质量 ≥ 41 kg，负重轮是 50 kg
    },
    "xr": {
      "lower_limit": 1, //下限高于上限表示绕 X 轴自由滚动
      "upper_limit": -1
    }
  }
}
