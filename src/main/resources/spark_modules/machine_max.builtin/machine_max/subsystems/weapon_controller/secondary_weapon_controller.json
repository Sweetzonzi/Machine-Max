{
  "$schema": "../../docs/zh_cn/schemas/subsystem/subsystem_static_attr.schema.json",
  "type": "machine_max:weapon_controller", //武器控制子系统，负责目标跟踪、控制炮塔/发射器
  "basic_durability": 100,
  "fire_mode": "SALVO", //(可选, 默认SALVO)射击模式: SALVO(齐射) / RIPPLE(轮射)
  "aim_inputs": [ //瞄准信号优先级
    "aim_input_p0",
    "aim_input_p1",
    "aim_input_p2",
    "aim_input_p3",
    "aim_input"
  ],
  "fire_inputs": [ // 开火信号优先级
    "secondary_fire_input_p0",
    "secondary_fire_input_p1",
    "secondary_fire_input_p2",
    "secondary_fire_input_p3",
    "secondary_fire_input"
  ],
  "aim_tolerance_deg": 60.0 //(可选, 默认3.0)瞄准容差角度(°)。发射器指向与目标偏差小于此值时允许开火，设为大于180(如360)则禁用容差检查
}
