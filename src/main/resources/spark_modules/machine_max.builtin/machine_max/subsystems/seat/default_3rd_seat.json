{
  "$schema": "../../docs/zh_cn/schemas/subsystem/subsystem_static_attr.schema.json",
  "type": "machine_max:seat", //子系统类型
  "block_damage": false, //(可选,默认false)是否无条件阻拦乘客受到伤害
  "render_passenger": false, //(可选,默认true)是否渲染乘客
  "views": {
    "enable_first_person": false, //(可选,默认true)是否启用第一人称视角
    "enable_third_person": true, //(可选,默认true)是否启用第三人称视角
    "third_person_hud": ["machine_max:example_hud"],//(可选,默认[])第三人称视角下的HUD组件
    "follow_vehicle": true, //(可选,默认true)第三人称视角是否跟随载具旋转
    "focus_on_center": true, //(可选,默认true)第三人称视角是否聚焦于载具中心
    "distance_scale": 1.2, //(可选,默认1.1)第三人称视角距离倍率
    "third_person_offset": [0, 2, 0], //(可选,默认[0, 0.75, 0])第三人称视角的偏移量
    "min_pitch": -70, //(可选,默认-70)第三人称视角的俯仰角范围下限
    "max_pitch": 45, //(可选,默认45)第三人称视角的俯仰角范围上限
    "yaw_limit": 270 //(可选,默认180)第三人称视角的偏航角范围限制，180代表±90°
  },
  "allow_use_items": false //(可选,默认false)是否允许乘客执行开启物品栏、使用物品等操作
}