      "count": 6 // 武器部件：火炮、机枪与发射器
    },
    {
      "ingredient": {
        "item": "machine_max:mechanic_component_1"
      },
      "count": 5 // 机械零件：方位/俯仰随动、炮架与导弹俯仰机构
    },
    {
      "ingredient": {
        "item": "machine_max:electronic_component_1"
      },
      "count": 8 // 电子元件：观瞄、席位与控制单元
