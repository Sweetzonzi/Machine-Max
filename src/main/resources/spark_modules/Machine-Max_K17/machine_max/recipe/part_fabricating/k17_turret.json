    {
      "ingredient": {
        "item": "minecraft:glass_pane"
      },
      "count": 2 // 玻璃板：观察窗与潜望镜，表尾最先被击碎
    }
  ],
  // 2 t 炮塔：2A42、PKTM 与两侧反坦克导弹发射器都算武器件，导弹火控与装填链让电子件到 8 份
  "result": {
    "count": 1
  },
  "time": 320
