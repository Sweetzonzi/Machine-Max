{
  "type": "machine_max:launcher",
  "single_round_loading": false,
  "basic_durability": 45,
  "pass_damage": false, //(可选, 默认true)是否将子系统受到的伤害传递给零件
  "control_inputs": [
    "weapon.autocannon",
    "weapon.autocannon.2a42"
  ],
  "barrel": {
    "horizontal_accuracy_multiplier": 1,
    "vertical_accuracy_multiplier": 1,
    "recoil_multiplier": 1.3
  },
  "breech": {
    "fire_rate": 550,
    "required_tags": [
      "machine_max:caliber/30mm"
    ]
  },
  //开火这一层的声音都按本型号配置：0.0 是单发，其余键是连射循环档位（按 fire_rate 取最近的一档）
  "sounds": {
    "fire": {
      "0.0": {
        "sound_id": "machine_max:projectile.fire.30mm_2a42",
        "range": 160.0
      },
      "550.0": {
        "sound_id": "machine_max:projectile.fire.30mm_2a42_loop",
        "range": 160.0
      }
    },
    "cease_fire": {
      "sound_id": "machine_max:projectile.fire.30mm_2a42_tail",
      "range": 160.0
    },
    "shell": {
      "0.0": {
        "sound_id": "machine_max:projectile.shell.fall",
        "range": 16.0
      },
      "550.0": {
        "sound_id": "machine_max:projectile.shell.shells_fall",
        "range": 16.0
      }
    }
  },
  "$schema": "../../docs/zh_cn/schemas/subsystem/subsystem_static_attr.schema.json"
}
